<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Zigzag.entitlements plus passkeys, which Apple granted to the released app's bundle id only. Change both together. -->
	<key>com.apple.developer.web-browser.public-key-credential</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<false/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Your own card in Contacts, to fill your name, email, phone and address into forms. -->
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Saved passwords live in this group of the data protection keychain, which also syncs through iCloud Keychain.
	     It keeps its first name: renaming it would hide every password already saved. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.zigzag.passwords</string>
	</array>
</dict>
</plist>
