            "value" : "Язык, на котором вы читаете."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okuduğunuz dil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
