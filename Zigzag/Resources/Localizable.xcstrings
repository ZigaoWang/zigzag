        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果還沒開啟該網站的分頁，新分頁會放在最上方。"
          }
        }
      }
    },
    "A page from a site with no tabs open goes at the bottom." : {
