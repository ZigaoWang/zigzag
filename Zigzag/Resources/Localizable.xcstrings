    "Check your Wi-Fi or network connection. Zigzag tries again by itself once you’re back online." : {
      "comment" : "Message on the page Zigzag shows when a page can't load because the Mac is offline.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe deine WLAN- oder Netzwerkverbindung. Zigzag versucht es von selbst erneut, sobald du wieder online bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba tu conexión Wi-Fi o de red. Zigzag lo vuelve a intentar automáticamente cuando recuperes la conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez votre connexion Wi-Fi ou réseau. Zigzag réessaie automatiquement dès que vous êtes de nouveau en ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la connessione Wi-Fi o di rete. Zigzag riprova da solo non appena torni online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fiまたはネットワーク接続を確認してください。オンラインに戻ると、Zigzagが自動的にもう一度試します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi 또는 네트워크 연결을 확인하세요. 다시 온라인 상태가 되면 Zigzag가 자동으로 다시 시도합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer je wifi- of netwerkverbinding. Zigzag probeert het zelf opnieuw zodra je weer online bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź połączenie Wi-Fi lub sieciowe. Zigzag spróbuje ponownie samodzielnie po przywróceniu połączenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique sua conexão Wi-Fi ou de rede. O Zigzag tenta novamente sozinho quando você voltar a ficar on-line."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте подключение к Wi-Fi или сети. Zigzag повторит попытку сам, когда вы снова подключитесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi veya ağ bağlantınızı kontrol edin. Tekrar çevrimiçi olduğunuzda Zigzag kendiliğinden yeniden dener."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查你的 Wi-Fi 或网络连接。恢复联网后，Zigzag 会自动再试一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請檢查你的 Wi-Fi 或網路連線。恢復聯網後，Zigzag 會自動再試一次。"
          }
        }
      }
    },
