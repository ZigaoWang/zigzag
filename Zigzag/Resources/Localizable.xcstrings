            "state" : "translated",
            "value" : "%@ heeft een hoofdwachtwoord. Typ het om de wachtwoorden over te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ma hasło główne. Wpisz je, aby zaimportować hasła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
