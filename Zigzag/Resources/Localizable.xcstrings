            "value" : "De groep wordt in %@ vastgezet als map, met alle tabbladen erin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupa jest przypięta w przestrzeni „%@” jako folder ze wszystkimi swoimi kartami."
          }
        },
        "pt-BR" : {
