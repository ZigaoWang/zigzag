    "%@ can’t hear this tab. Its sound is protected or can’t be reached." : {
      "comment" : "Toast when an extension asks to hear a tab whose sound Zigzag can't hand it (protected video, or sound it can't reach). The placeholder is the extension's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann bei diesem Tab nicht mithören. Sein Ton ist geschützt oder nicht erreichbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede oír esta pestaña. Su sonido está protegido o no se puede alcanzar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas entendre cet onglet. Son audio est protégé ou inaccessible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non riesce a sentire questo pannello. L’audio è protetto o non raggiungibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はこのタブの音声を取得できません。音声が保護されているか、取得できない状態です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 이 탭의 사운드를 들을 수 없습니다. 사운드가 보호되어 있거나 접근할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan dit tabblad niet horen. Het geluid is beveiligd of niet bereikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie słyszy tej karty. Jej dźwięk jest chroniony lub niedostępny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não consegue ouvir esta aba. O som dela é protegido ou inacessível."
