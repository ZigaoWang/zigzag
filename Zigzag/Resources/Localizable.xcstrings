    "%@: in its settings, choose Browser, then Add Browser" : {
      "comment" : "Toast when an extension needs a step in its own app. The placeholder is a title like “Connect 1Password to Zigzag”. Browser and Add Browser are names in 1Password's settings.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Wähle in den Einstellungen „Browser“ und dann „Browser hinzufügen“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: en sus ajustes, elige Navegador y luego Añadir navegador"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : dans ses réglages, choisissez Navigateur, puis Ajouter un navigateur"
          }
        },
        "it" : {
