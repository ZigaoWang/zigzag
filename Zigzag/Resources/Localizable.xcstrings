    "%@: %@?" : {
      "comment" : "VoiceOver label of a site's permission question: the site, then its request, like “zoom.us: Use your camera?”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@?"
