        }
      }
    },
    "A rule that hasn’t been told asks the first time it fires, and keeps your answer." : {
      "comment" : "Tooltip on the Open in choice of an Open URL download rule.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Regel ohne Vorgabe fragt beim ersten Auslösen und merkt sich deine Antwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una regla sin respuesta previa pregunta la primera vez que se activa y conserva tu respuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une règle sans réponse enregistrée pose la question lors de son premier déclenchement, puis retient votre réponse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se non le hai ancora dato una risposta, la regola te lo chiede la prima volta che si attiva e la ricorda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ指定していないルールは、最初に実行されるときに確認し、その答えを記憶します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 선택하지 않은 규칙은 처음 실행될 때 묻고, 그 선택을 기억합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een regel waarvoor je nog niets hebt aangegeven, vraagt het de eerste keer dat hij wordt geactiveerd en onthoudt je antwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reguła bez ustawionej odpowiedzi pyta przy pierwszym uruchomieniu i zapamiętuje odpowiedź."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma regra que ainda não foi respondida pergunta na primeira vez que for acionada e mantém a sua resposta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правило без заданного ответа спрашивает при первом срабатывании и запоминает ваш ответ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz sorulmamış bir kural, ilk tetiklendiğinde sorar ve yanıtınızı saklar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没指定位置的规则会在第一次触发时询问，并记住你的选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還沒指定位置的規則會在第一次觸發時詢問，並記住你的選取。"
          }
        }
      }
    },
    "A site covers every port and its subdomains: localhost is localhost:3000 and app.localhost too." : {
      "comment" : "Under the list in Settings › Developer.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Website umfasst alle Ports und ihre Subdomains: localhost steht auch für localhost:3000 und app.localhost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sitio abarca todos los puertos y sus subdominios: localhost es localhost:3000 y también app.localhost."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un site couvre tous les ports et ses sous-domaines : localhost inclut localhost:3000 et app.localhost."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sito comprende ogni porta e i suoi sottodomini: localhost vale per localhost:3000 e anche per app.localhost."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイトには、すべてのポートとサブドメインが含まれます。localhostにはlocalhost:3000やapp.localhostも含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사이트는 모든 포트와 하위 도메인에 적용됩니다. localhost는 localhost:3000과 app.localhost도 포함합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een website omvat elke poort en haar subdomeinen: localhost is ook localhost:3000 en app.localhost."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witryna obejmuje każdy port i jej subdomeny: localhost to także localhost:3000 i app.localhost."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um site abrange todas as portas e seus subdomínios: localhost é localhost:3000 e app.localhost também."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сайт охватывает все порты и его поддомены: localhost — это и localhost:3000, и app.localhost."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir site tüm bağlantı noktalarını ve alt alan adlarını kapsar: localhost, localhost:3000 ve app.localhost için de geçerlidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个网站涵盖它的所有端口和子域名：localhost 也包括 localhost:3000 和 app.localhost。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "網站規則涵蓋所有連接埠和子網域。例如，localhost 也符合 localhost:3000 和 app.localhost。"
          }
        }
      }
    },
    "A small window for a quick look at a page. Esc closes it, and ⌘O moves it into your browser window to keep it." : {
      "comment" : "Explanation under “New Zigzag Mini” in Settings › Zigzag Mini: what Zigzag Mini is.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kleines Fenster für einen kurzen Blick auf eine Seite. Esc schließt es, und ⌘O bewegt es in dein Browserfenster, um die Seite zu behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una ventana pequeña para echar un vistazo rápido a una página. Esc la cierra y ⌘O la lleva a la ventana del navegador para conservarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une petite fenêtre pour jeter un coup d’œil à une page. Échap la ferme, et ⌘O la déplace dans votre fenêtre de navigation pour la conserver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una piccola finestra per dare un’occhiata a una pagina. Esc la chiude e ⌘O la sposta nella finestra del browser per tenerla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページをちょっと確認するための小さなウインドウです。Escで閉じ、⌘Oでブラウザウインドウに移して残せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페이지를 빠르게 훑어보는 작은 윈도우입니다. Esc를 누르면 닫히고, ⌘O를 누르면 브라우저 윈도우로 옮겨 유지할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een klein venster om snel naar een pagina te kijken. Met Esc sluit je het en met ⌘O verplaats je het naar je browservenster om het te houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Małe okno do szybkiego podglądu strony. Esc je zamyka, a ⌘O przenosi je do okna przeglądarki, aby je zachować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma janela pequena para dar uma olhada rápida em uma página. Esc a fecha, e ⌘O a move para a janela do navegador para mantê-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Небольшое окно для быстрого просмотра страницы. Esc закрывает его, а ⌘O переносит в окно браузера, чтобы оставить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sayfaya hızlıca göz atmak için küçük bir pencere. Esc onu kapatır, ⌘O ise saklamak üzere tarayıcı pencerenize taşır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用一个小窗口快速看一眼页面。按 Esc 关闭，按 ⌘O 移到浏览器窗口中留下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用一個小視窗快速看一眼網頁。按 Esc 關閉，按 ⌘O 移到瀏覽器視窗中留下。"
          }
        }
      }
    },
    "A space you make gets a profile named after it, with its own sign-ins, extensions and history. Spaces you have now stay on theirs." : {
      "comment" : "Explanation under “Give new spaces their own profile” in Settings › Spaces.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neuer Space erhält ein eigenes Profil mit seinem Namen und eigenen Anmeldungen, Erweiterungen und einem eigenen Verlauf. Deine vorhandenen Spaces bleiben in ihren Profilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un espacio nuevo recibe un perfil con su nombre, con sus propios inicios de sesión, extensiones e historial. Los espacios que ya tienes se quedan en el suyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque espace que vous créez reçoit un profil portant son nom, avec ses propres connexions, extensions et historique. Vos espaces actuels conservent le leur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno spazio che crei ottiene un profilo con il suo nome, con accessi, estensioni e cronologia propri. Gli spazi che hai ora restano sui loro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しく作るスペースには、その名前のプロファイルが作成され、専用のログイン状態、機能拡張、履歴を持ちます。今あるスペースは現在のプロファイルのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로 만드는 스페이스에는 이름이 같은 프로필이 생성되며, 로그인 상태, 확장 프로그램 및 방문 기록을 따로 갖습니다. 기존 스페이스는 현재 프로필에 그대로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een space die je maakt krijgt een profiel met dezelfde naam, met eigen aanmeldingen, extensies en geschiedenis. Spaces die je nu hebt, blijven op hun eigen profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przestrzeń, którą utworzysz, dostaje profil o jej nazwie, z własnymi logowaniami, rozszerzeniami i historią. Dotychczasowe przestrzenie pozostają przy swoich profilach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um espaço que você cria ganha um perfil com o mesmo nome, com os próprios logins, extensões e histórico. Os espaços que você já tem continuam nos perfis deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для нового пространства создаётся профиль с его именем, со своими входами, расширениями и историей. Уже существующие пространства остаются в своих профилях."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oluşturduğunuz her Space, adını taşıyan ve kendi girişleri, genişletmeleri ve geçmişi olan bir profil alır. Şu anki Space’leriniz kendi profillerinde kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新建的空间会有一份以它命名的个人资料，有自己的登录状态、扩展和历史记录。现有的空间保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增的空間會有一份以它命名的個人資料，有自己的登入狀態、延伸功能和瀏覽記錄。現有的空間保持不變。"
          }
        }
      }
    },
    "A style can’t hold a tag like </style>." : {
      "comment" : "Under the code field of the Edit Style sheet, while the CSS holds an HTML tag: why Save can't be pressed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Stil darf kein Tag wie </style> enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un estilo no puede contener una etiqueta como </style>."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un style ne peut pas contenir de balise comme </style>."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno stile non può contenere un tag come </style>."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スタイルには</style>のようなタグを含めることはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스타일에는 </style> 같은 태그를 포함할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een stijl mag geen tag als </style> bevatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styl nie może zawierać znacznika takiego jak </style>."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um estilo não pode conter uma tag como </style>."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В стиле не может быть тега вроде </style>."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir stil, </style> gibi bir etiket içeremez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "样式里不能有 </style> 这样的标签。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "樣式裡不能有 </style> 這樣的標籤。"
          }
        }
      }
    },
    "A style can’t load anything from the web, with @import or a web address." : {
      "comment" : "Under the code field of the Edit Style sheet, while the CSS imports or loads something from the web: why Save can't be pressed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Stil kann nichts aus dem Web laden, weder mit @import noch über eine Webadresse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un estilo no puede cargar nada de la web, con @import o una dirección web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un style ne peut rien charger depuis le Web, ni avec @import ni avec une adresse web."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno stile non può caricare nulla dal web, con @import o un indirizzo web."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スタイルでは、@importやWebアドレスを使ってWebから読み込むことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스타일은 @import나 웹 주소로 웹에서 아무것도 로드할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een stijl kan niets van het web laden, met @import of een webadres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styl nie może wczytywać niczego z sieci za pomocą @import ani adresu internetowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um estilo não pode carregar nada da web, com @import ou endereço da web."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стиль не может ничего загружать из сети через @import или веб-адрес."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir stil, @import veya bir web adresiyle web’den bir şey yükleyemez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "样式不能通过 @import 或网址从网上载入任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "樣式不能透過 @import 或網址從網路上載入任何內容。"
          }
        }
      }
    },
    "A tab needs your answer" : {
