    },
    "%lld tabs" : {
      "comment" : "In the tab overview (all spaces' tabs as cards), beside a space's name: how many tabs it has.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
