    },
    "I Understand" : {
      "comment" : "Button that acknowledges the briefing and turns the setting on.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我已了解"
          }
        }
      }
    },
    "In Low Power Mode, Clear shows as Frosted to save power." : {
      "comment" : "Under Glass in the space editor, while Low Power Mode is on: clear glass shows as frosted until it's off.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低电量模式下，“透明”会显示为“磨砂”以节省电量。"
          }
        }
      }
    },
    "The mini player’s right-click menu can turn this off too." : {
      "comment" : "Explanation under “Show a mini player when you switch tabs” in Settings › Tabs.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The mini player’s right-click menu can turn this off too."
          }
