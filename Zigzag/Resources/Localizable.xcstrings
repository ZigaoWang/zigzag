        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag no pudo leer las contraseñas que ya tiene, así que no añadió ninguna. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag n’a pas pu lire les mots de passe dont il dispose déjà : il n’en a donc ajouté aucun. Réessayez."
          }
