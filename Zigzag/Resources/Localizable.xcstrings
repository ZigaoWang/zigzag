    "Sync with iCloud?" : {
      "comment" : "Title of the sheet shown when Sync with iCloud is turned on in Settings › General.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit iCloud synchronisieren?"
          }
        },
        "es" : {
