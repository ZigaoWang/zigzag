      }
    },
    "This site tried to use WebRTC, which you’ve blocked." : {
      "comment" : "Notice over a page when WebRTC is off for it (Settings › Privacy › Protect IP address from WebRTC) and the page tried to use it, as a call site like Google Meet does. WebRTC is a name: keep it as it is.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
