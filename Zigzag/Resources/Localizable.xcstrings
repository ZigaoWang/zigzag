    "System (%@)" : {
      "comment" : "First choice of the Language menu in Settings › General. The placeholder is the language the Mac would pick, named in itself.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统（%@）"
