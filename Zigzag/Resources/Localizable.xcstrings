    "Where ⌘T and links put a new tab in the sidebar." : {
      "comment" : "Explanation under “New tabs open” in Settings › Tabs.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo ⌘T und Links einen neuen Tab in der Seitenleiste platzieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dónde se coloca en la barra lateral una pestaña nueva de ⌘T o de un enlace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où ⌘T et les liens placent un nouvel onglet dans la barre latérale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove ⌘T e i link inseriscono un nuovo pannello nella barra laterale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Tやリンクで開いた新規タブを、サイドバーのどこに置くかを選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘T와 링크로 여는 새로운 탭이 사이드바에서 놓일 위치입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waar ⌘T en links een nieuw tabblad in de navigatiekolom plaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miejsce, w którym ⌘T i linki umieszczają nową kartę na pasku bocznym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde o ⌘T e os links colocam uma nova aba na barra lateral."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Куда ⌘T и ссылки помещают новую вкладку в боковом меню."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘T ve bağlantıların yeni bir sekmeyi kenar çubuğunda nereye koyduğu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘T 和链接打开的新标签页在边栏中的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "決定按下 ⌘T 或透過連結開啟的分頁要放在側邊欄的哪個位置。"
          }
        }
      }
    },
    "A page from a site with no tabs open goes at the top." : {
      "comment" : "Explanation under “New tabs open” in Settings › Tabs when Next to Tabs from the Same Site is chosen.",
      "localizations" : {
        "de" : {
