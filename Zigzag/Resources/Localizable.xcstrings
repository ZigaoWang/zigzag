    "Checks every %lld minutes, or hourly in Low Power Mode." : {
      "comment" : "Under the fields of the New Live Folder sheet: how often a live folder fetches its feed or list. The number is minutes (30).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft alle %lld Minuten, im Stromsparmodus stündlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba cada %lld minutos, o cada hora en modo de bajo consumo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérification toutes les %lld minutes, ou toutes les heures en mode Économie d’énergie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla ogni %lld minuti, oppure ogni ora in modalità Risparmio energetico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld分ごとに確認します。低電力モードでは1時間ごとです。"
