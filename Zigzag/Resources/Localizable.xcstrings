    "%@ isn’t a Safari export Zigzag can open. In Safari, choose File › Export Browsing Data, then choose the zip it makes." : {
      "comment" : "Problem in the Import window. The placeholder is the file's name; File › Export Browsing Data is Safari's own menu wording.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist kein Safari-Export, den Zigzag öffnen kann. Wähle in Safari „Ablage“ › „Browserdaten exportieren“ und dann die erstellte ZIP-Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no es una exportación de Safari que Zigzag pueda abrir. En Safari, elige Archivo › Exportar datos de navegación y luego elige el zip que crea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas une exportation Safari que Zigzag peut ouvrir. Dans Safari, choisissez Fichier › Exporter les données de navigation dans un fichier, puis choisissez le fichier zip obtenu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è un’esportazione di Safari che Zigzag possa aprire. In Safari scegli File › Esporta dati di navigazione, poi scegli lo zip che viene creato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はZigzagで開けるSafariの書き出しファイルではありません。Safariで「ファイル › ブラウズデータをファイルに書き出す」を選択してから、作成されたzipファイルを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) Zigzag가 열 수 있는 Safari 내보내기 파일이 아닙니다. Safari에서 파일 › 브라우징 데이터 내보내기를 선택한 다음 생성된 zip 파일을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is geen Safari-export die Zigzag kan openen. Kies in Safari Archief › Exporteer browsegegevens en kies daarna de zip die dat oplevert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik %@ nie jest eksportem z Safari, który Zigzag potrafi otworzyć. W Safari wybierz „Plik” › „Eksportuj dane przeglądania”, a następnie wybierz utworzony plik zip."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não é uma exportação do Safari que o Zigzag consiga abrir. No Safari, escolha Arquivo › Exportar dados de navegação e escolha o zip gerado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не является экспортом Safari, который Zigzag может открыть. В Safari выберите «Файл» › «Экспортировать данные просмотра», затем выберите созданный zip-файл."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen dosya (%@), Zigzag’in açabileceği bir Safari dışa aktarımı değil. Safari’de “Dosya” › “Gezinme Verilerini Dosyaya Aktar” seçeneğini seçin, sonra oluşturduğu zip dosyasını seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是 Zigzag 能打开的 Safari 导出文件。在 Safari 中，选取“文件 › 导出浏览数据”，然后选择它生成的 zip 文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」不是 Zigzag 能開啟的 Safari 匯出檔案。在 Safari 中，選取「檔案 › 匯出瀏覽資料」，然後選取它產生的 zip 檔案。"
          }
        }
      }
    },
    "%@ isn’t a password export Zigzag recognizes. Export a CSV from your password manager or browser and choose it." : {
      "comment" : "Problem in the Import window. The placeholder is the chosen file's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist kein Passwortexport, den Zigzag erkennt. Exportiere eine CSV-Datei aus deinem Passwortmanager oder Browser und wähle sie aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no es una exportación de contraseñas que Zigzag reconozca. Exporta un CSV desde tu gestor de contraseñas o tu navegador y elígelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas une exportation de mots de passe reconnue par Zigzag. Exportez un fichier CSV depuis votre gestionnaire de mots de passe ou votre navigateur, puis choisissez-le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è un’esportazione di password riconosciuta da Zigzag. Esporta un CSV dal tuo gestore di password o dal browser e scegli quel file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はZigzagが認識できるパスワードの書き出しファイルではありません。パスワードマネージャやブラウザからCSVを書き出して、そのファイルを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) Zigzag가 인식할 수 있는 암호 내보내기 파일이 아닙니다. 암호 관리자나 브라우저에서 CSV 파일을 내보낸 다음 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is geen wachtwoordexport die Zigzag herkent. Exporteer een CSV-bestand uit je wachtwoordbeheerder of browser en kies dat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik %@ nie jest eksportem haseł rozpoznawanym przez Zigzag. Wyeksportuj plik CSV z menedżera haseł lub przeglądarki i wybierz go."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não é uma exportação de senhas que o Zigzag reconheça. Exporte um CSV do seu gerenciador de senhas ou navegador e escolha-o."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag не распознаёт %@ как экспорт паролей. Экспортируйте файл CSV из менеджера паролей или браузера и выберите его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen dosya (%@), Zigzag’in tanıdığı bir parola dışa aktarımı değil. Parola yöneticinizden veya tarayıcınızdan bir CSV dışa aktarın ve onu seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是 Zigzag 能识别的密码导出文件。请从你的密码管理器或浏览器导出 CSV 文件，然后选择它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」不是 Zigzag 能辨識的密碼匯出檔案。請從你的密碼管理器或瀏覽器匯出 CSV 檔案，然後選取它。"
          }
        }
      }
    },
    "%@ isn’t downloaded for translation. Choose Translate again to download it." : {
      "comment" : "Toast when a page couldn't be translated because macOS's download of its language was closed without downloading it. The language is its name, like French.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist für die Übersetzung nicht geladen. Wähle erneut „Übersetzen“, um die Sprache zu laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está descargado para la traducción. Elige Traducir de nuevo para descargarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langue non téléchargée pour la traduction : %@. Choisissez à nouveau Traduire pour la télécharger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è scaricata per la traduzione. Scegli di nuovo Traduci per scaricarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は翻訳用にダウンロードされていません。もう一度「翻訳」を選択するとダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "번역에 필요한 %@ 데이터가 다운로드되지 않았습니다. 다운로드하려면 번역을 다시 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is niet gedownload voor vertaling. Kies opnieuw Vertaal om het te downloaden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Język „%@” nie został pobrany do tłumaczenia. Wybierz „Tłumacz” ponownie, aby go pobrać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não foi baixado para tradução. Escolha Traduzir mais uma vez para baixá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Язык %@ не загружен для перевода. Снова выберите «Перевести», чтобы загрузить его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” dili çeviri için indirilmemiş. İndirmek için “Çevir”i yeniden seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有下载%@的翻译语言。再选一次“翻译”即可下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未下載%@的翻譯資料。請再選一次「翻譯」以下載。"
          }
        }
      }
    },
    "%@ keeps its %lld passwords in a newer format Zigzag can’t read yet. Export them from %@’s Passwords page as a CSV file, then choose it here." : {
      "comment" : "Problem in the Import window. The placeholders are a browser's name, like Firefox, and how many passwords it has.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bewahrt seine %2$lld Passwörter in einem neueren Format auf, das Zigzag noch nicht lesen kann. Exportiere sie auf der Passwortseite von %3$@ als CSV-Datei und wähle sie dann hier aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ keeps its %2$lld passwords in a newer format Zigzag can’t read yet. Export them from %3$@’s Passwords page as a CSV file, then choose it here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ guarda sus %2$lld contraseñas en un formato más reciente que Zigzag aún no puede leer. Expórtalas como archivo CSV desde la página Contraseñas de %3$@ y elígelo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ conserve ses %2$lld mots de passe dans un format récent que Zigzag ne sait pas encore lire. Dans %3$@, exportez-les dans un fichier CSV depuis la page Mots de passe, puis choisissez ce fichier ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ conserva le sue %lld password in un formato più recente che Zigzag non riesce ancora a leggere. Esportale dalla pagina Password di %@ come file CSV, poi scegli il file qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は%2$lld件のパスワードを、Zigzagがまだ読めない新しい形式で保存しています。%3$@の「パスワード」ページからCSVファイルとして書き出してから、ここで選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) 암호 %2$lld개를 Zigzag가 아직 읽을 수 없는 새로운 형식으로 보관합니다. %3$@의 암호 페이지에서 CSV 파일로 내보낸 다음 여기에서 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bewaart zijn %2$lld wachtwoorden in een nieuwer formaat dat Zigzag nog niet kan lezen. Exporteer ze vanaf de pagina Wachtwoorden van %3$@ als CSV-bestand en kies dat hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasła z %1$@ (%2$lld) są w nowszym formacie, którego Zigzag jeszcze nie odczytuje. Wyeksportuj je ze strony haseł w %3$@ jako plik CSV, a następnie wybierz go tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ guarda as %2$lld senhas em um formato mais novo que o Zigzag ainda não consegue ler. Exporte-as da página Senhas de %3$@ como arquivo CSV e escolha-o aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароли в %1$@ (%2$lld) хранятся в более новом формате, который Zigzag пока не может прочитать. Экспортируйте их на странице «Пароли» в %3$@ в файл CSV и выберите его здесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tarayıcısında %2$lld parola, Zigzag’in henüz okuyamadığı daha yeni bir biçimde saklanıyor. Bunları %3$@ tarayıcısının Parolalar sayfasından CSV dosyası olarak dışa aktarın, sonra buradan seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 的 %2$lld 个密码使用了 Zigzag 暂时无法读取的新格式。请在 %3$@ 的“密码”页面将它们导出为 CSV 文件，然后在这里选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 的 %2$lld 個密碼使用了 Zigzag 暫時無法讀取的新格式。請在 %3$@ 的「密碼」網頁將它們匯出為 CSV 檔案，然後在這裡選取。"
          }
        }
      }
    },
