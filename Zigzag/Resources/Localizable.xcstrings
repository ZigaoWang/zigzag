          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расширения находятся в настройках сайта у адресной строки. Перенести ещё что-нибудь можно в любой момент в настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
