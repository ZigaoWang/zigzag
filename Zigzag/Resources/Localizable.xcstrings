        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag kon je profielen niet lezen, dus elke space staat voorlopig op Standaard. Het bestand is bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
