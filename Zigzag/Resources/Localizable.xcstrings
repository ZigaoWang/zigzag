    "When a page is in another language, Zigzag asks once per site." : {
      "comment" : "Explanation under “Offer to translate” in Settings › Translation.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist eine Seite in einer anderen Sprache, fragt Zigzag einmal pro Website."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando una página está en otro idioma, Zigzag pregunta una vez por sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu’une page est dans une autre langue, Zigzag pose la question une fois par site."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando una pagina è in un’altra lingua, Zigzag lo chiede una sola volta per sito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページがほかの言語のとき、Zigzagはサイトごとに1回確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페이지가 다른 언어로 되어 있으면 Zigzag가 사이트마다 한 번 묻습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
