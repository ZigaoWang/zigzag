    "Automatic fits fewer, larger ones in a narrow sidebar." : {
      "comment" : "Explanation under “Favorites per row” in Settings › Appearance.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatisch“ zeigt in einer schmalen Seitenleiste weniger, dafür größere Favoriten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Automático caben menos favoritos, y más grandes, en una barra lateral estrecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatique en affiche moins, mais plus grands, dans une barre latérale étroite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Automatico ne entrano meno, ma più grandi, in una barra laterale stretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」にすると、サイドバーが狭いときは大きめのアイコンを少なく表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동을 선택하면 사이드바가 좁을 때 더 적은 수의 큰 아이콘을 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met Automatisch passen er minder, grotere favorieten in een smalle navigatiekolom."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcja „Automatycznie” mieści mniej, ale większych elementów w wąskim pasku bocznym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo Automático usa menos itens, maiores, em uma barra lateral estreita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В узком боковом меню помещается меньше, но более крупных."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik, dar bir kenar çubuğunda daha az ve daha büyük öğe sığdırır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选“自动”时，边栏窄就放得少一些、大一些。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選「自動」時，側邊欄窄就放得少一些、大一些。"
          }
        }
      }
    },
