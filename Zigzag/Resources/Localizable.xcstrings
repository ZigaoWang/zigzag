    "Your name, email, phone and address, from your own card in Contacts." : {
      "comment" : "Explanation under “Fill forms from My Card” in Settings › Passwords.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Name, deine E-Mail-Adresse, Telefonnummer und Adresse aus deiner eigenen Karte in den Kontakten."
