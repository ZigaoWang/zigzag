    "The result can’t be given as text. For a promise, put await before it and return its value." : {
      "comment" : "Error a script gets when its JavaScript ends on a value like a promise or a page element.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ergebnis kann nicht als Text ausgegeben werden. Setze bei einem Promise await davor und gib seinen Wert zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El resultado no se puede dar como texto. Para una promesa, pon await delante y devuelve su valor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le résultat ne peut pas être renvoyé sous forme de texte. Pour une promesse, placez await devant et renvoyez sa valeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il risultato non può essere restituito come testo. Per una promise, metti await davanti e restituisci il suo valore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果をテキストとして返せません。Promiseの場合は、前にawaitを付けて、その値をreturnしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결과를 텍스트로 반환할 수 없습니다. Promise인 경우 앞에 await를 붙이고 그 값을 반환하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het resultaat kan niet als tekst worden gegeven. Zet bij een promise await ervoor en geef de waarde terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyniku nie można podać jako tekstu. W przypadku obietnicy (promise) dodaj przed nią await i zwróć jej wartość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O resultado não pode ser dado como texto. Para uma promise, coloque await antes dela e retorne o valor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Результат нельзя вывести как текст. Для промиса поставьте перед ним await и верните его значение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonuç metin olarak verilemez. Bir promise için önüne await koyun ve değerini döndürün."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结果无法以文本形式返回。如果是 Promise，请在前面加上 await 并 return 它的值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果無法以文字形式返回。如果是 Promise，請在前面加上 await 並 return 它的值。"
          }
        }
      }
    },
