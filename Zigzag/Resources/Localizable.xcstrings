          }
        }
      }
    },
    "The video floats over other apps and desktops, and goes back in its page when you return." : {
      "comment" : "Explanation under “Show a mini player when you leave Zigzag” in Settings › Tabs.",
      "localizations" : {
        "zh-Hans" : {
