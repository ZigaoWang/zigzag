        }
      }
    },
    "Extensions come from Chrome and browsers built on it. Firefox and Safari get theirs from stores of their own." : {
      "comment" : "Note under the choices in the Import window, when Extensions is chosen along with Firefox or Safari.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erweiterungen kommen aus Chrome und darauf basierenden Browsern. Firefox und Safari beziehen ihre aus eigenen Stores."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las extensiones vienen de Chrome y de navegadores basados en él. Firefox y Safari obtienen las suyas de sus propias tiendas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les extensions proviennent de Chrome et des navigateurs basés sur Chrome. Firefox et Safari ont leurs propres boutiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le estensioni provengono da Chrome e dai browser basati su di esso. Firefox e Safari ottengono le proprie da store propri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "機能拡張はChromeとChromeベースのブラウザから読み込めます。FirefoxとSafariの機能拡張はそれぞれのストアから入手します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확장 프로그램은 Chrome 및 Chrome 기반 브라우저에서 가져옵니다. Firefox와 Safari는 자체 스토어에서 확장 프로그램을 받습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extensies komen uit Chrome en browsers die erop gebaseerd zijn. Firefox en Safari halen de hunne uit eigen stores."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozszerzenia pochodzą z Chrome i przeglądarek na nim opartych. Firefox i Safari mają własne sklepy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As extensões vêm do Chrome e de navegadores baseados nele. O Firefox e o Safari obtêm as deles em lojas próprias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расширения берутся из Chrome и основанных на нём браузеров. Firefox и Safari получают их из собственных магазинов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genişletmeler Chrome’dan ve onun üzerine kurulu tarayıcılardan gelir. Firefox ve Safari kendi mağazalarından alır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扩展只能从 Chrome 及基于它的浏览器导入。Firefox 和 Safari 的扩展来自它们各自的商店。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "延伸功能只能從 Chrome 及基於它的瀏覽器匯入。Firefox 和 Safari 的延伸功能來自它們各自的商店。"
          }
        }
      }
    },
    "Extensions, sign-ins and history kept on this Mac" : {
