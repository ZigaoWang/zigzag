            "value" : "Ciò che digiti nella barra degli indirizzi viene inviato al tuo motore di ricerca per ottenere suggerimenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレスバーに入力した内容は、候補を表示するために検索エンジンに送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주소 막대에 입력한 내용이 제안을 위해 검색 엔진으로 전송됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat je in de adresbalk typt, wordt naar je zoekmachine gestuurd voor suggesties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co wpisujesz na pasku adresu, jest wysyłane do wyszukiwarki w celu uzyskania podpowiedzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
