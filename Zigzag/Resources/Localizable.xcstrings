      }
    },
    "Its tabs and pinned tabs close. This can’t be undone." : {
      "comment" : "Message of the sheet that deletes a space from Settings.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Tabs und fixierten Tabs werden geschlossen. Dies kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cierran sus pestañas y pestañas fijadas. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses onglets et onglets épinglés sont fermés. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suoi pannelli e i pannelli fissati vengono chiusi. L’operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブと固定タブが閉じます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭과 고정된 탭이 닫힙니다. 이 동작은 실행 취소할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tabbladen en vastgezette tabbladen worden gesloten. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jej karty i przypięte karty zostaną zamknięte. Tej czynności nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As abas e as abas fixadas dele são fechadas. Isto não pode ser desfeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его вкладки и закреплённые вкладки закроются. Это нельзя отменить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekmeleri ve sabitlenmiş sekmeleri kapanır. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的标签页和已固定标签页都会关闭。此操作不可撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的分頁和已固定分頁都會關閉。此操作不可復原。"
          }
        }
      }
    },
    "Its tabs and pinned tabs close. You can bring them back with Undo in a browser window." : {
      "comment" : "Message of the sheet that deletes a space from Settings.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Tabs und fixierten Tabs werden geschlossen. Du kannst sie in einem Browserfenster mit „Widerrufen“ zurückholen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cierran sus pestañas y pestañas fijadas. Puedes recuperarlas con Deshacer en una ventana del navegador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses onglets et onglets épinglés sont fermés. Vous pouvez les récupérer avec Annuler dans une fenêtre de navigation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suoi pannelli e i pannelli fissati vengono chiusi. Puoi recuperarli con Annulla in una finestra del browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブと固定タブが閉じます。ブラウザウインドウで「取り消す」を使うと元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭과 고정된 탭이 닫힙니다. 브라우저 윈도우에서 실행 취소로 되돌릴 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tabbladen en vastgezette tabbladen worden gesloten. Je kunt ze terughalen met Maak ongedaan in een browservenster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jej karty i przypięte karty zostaną zamknięte. Możesz je przywrócić poleceniem „Cofnij” w oknie przeglądarki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As abas e as abas fixadas dele são fechadas. Você pode recuperá-las com Desfazer em uma janela do navegador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его вкладки и закреплённые вкладки закроются. Вернуть их можно командой «Отменить» в окне браузера."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekmeleri ve sabitlenmiş sekmeleri kapanır. Bir tarayıcı penceresinde Geri Al ile geri getirebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的标签页和已固定标签页都会关闭。你可以在浏览器窗口中用“撤销”找回它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的分頁和已固定分頁都會關閉。你可以在瀏覽器視窗中用「復原」找回它們。"
          }
        }
      }
    },
