    "Asleep to save energy." : {
      "comment" : "Under a sleeping tab's title in its hover card, or its tooltip: Zigzag put it to sleep because it used a lot of energy in the background.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruht, um Energie zu sparen."
          }
        },
