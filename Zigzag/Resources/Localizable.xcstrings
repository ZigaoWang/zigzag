          }
        }
      }
    },
    "%lld updates need your approval." : {
      "comment" : "Toast after Check for Updates in Settings › Extensions: how many updates ask for more access and wait for you.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
