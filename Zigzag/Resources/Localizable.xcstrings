    "Your Mac doesn’t let Zigzag open it." : {
      "comment" : "Message on the page Zigzag shows when a page can't load.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mac lässt Zigzag sie nicht öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac no deja que Zigzag lo abra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac n’autorise pas Zigzag à l’ouvrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Mac non consente a Zigzag di aprirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacがZigzagにこれを開くことを許可していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
