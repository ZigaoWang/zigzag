          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma exportação de senhas (arquivo .csv), uma exportação de marcadores (arquivo .html) ou os dados de navegação exportados do Safari (arquivo .zip)."
          }
        },
        "ru" : {
          "stringUnit" : {
