{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ are saved first, then passed to %@" : {
      "comment" : "A File handoff in a sentence: what it catches is downloaded first, then given to the script. The placeholders are the two parts.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ werden zuerst geladen und dann an %@ übergeben"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se guardan primero y después se envían a %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sont d’abord enregistrés, puis transférés à %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vengono salvati prima, poi trasferiti a %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@を先に保存してから、%2$@に渡す"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 먼저 저장된 후 %@에 전달됩니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ worden eerst bewaard en daarna doorgegeven aan %@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ są najpierw zachowywane, a następnie przekazywane do: %2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ são salvos primeiro e depois entregues a %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ сначала сохраняются, затем передаются в %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ önce kaydedilir, sonra şuraya devredilir: %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先把 %@ 保存下来，然后交给 %@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先儲存 %@，然後交給 %@"
          }
        }
      }
    },
    "%@ are saved first, then passed to %@; links hand off just their address" : {
      "comment" : "A File handoff that also catches links, in a sentence: downloads are saved first, then given to the script, while a link is given as its address without being saved. The placeholders are what it catches and the script.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ werden zuerst geladen und dann an %@ übergeben; Links übergeben nur ihre Adresse"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se guardan primero y después se envían a %@; los enlaces solo envían su dirección"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sont d’abord enregistrés, puis transférés à %@ ; les liens transfèrent seulement leur adresse"
          }
