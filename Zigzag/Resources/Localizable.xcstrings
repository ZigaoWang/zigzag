    },
    "A beta can break." : {
      "comment" : "Explanation under “Beta updates” in Settings › General.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A beta can break."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta 版可能不稳定。"
          }
        }
      }
    },
    "A site you switch on in Site Controls can use fetch, XMLHttpRequest and WebSocket to talk to a program on this Mac, over loopback only. Never the local network, and a page can’t switch itself on." : {
      "comment" : "Explanation under the apps-on-this-Mac setting in Settings › Privacy. fetch, XMLHttpRequest and WebSocket are API names: keep them as they are.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在网站设置里开启的网站可以使用 fetch、XMLHttpRequest 和 WebSocket，与这台 Mac 上监听端口的程序通信，且只限本机回环。绝不涉及本地网络，页面也无法自行开启。"
          }
        }
      }
    },
    "Before You Allow This" : {
      "comment" : "Title of the briefing shown before the apps-on-this-Mac setting can be turned on.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启之前"
          }
        }
      }
    },
    "Black, not dark gray." : {
      "comment" : "Explanation under “Pure black backgrounds” in Settings › Appearance.",
