    },
    "Asleep to save energy. Freed about %@." : {
      "comment" : "Under a sleeping tab's title in its hover card, or its tooltip: Zigzag put it to sleep because it used a lot of energy in the background. The size is how much memory that gave back, like 180 MB.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruht, um Energie zu sparen. Etwa %@ freigegeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendida para ahorrar energía. Se liberaron unos %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En veille pour économiser l’énergie. Environ %@ libérés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sospeso per risparmiare energia. Liberati circa %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エネルギーを節約するためスリープ中です。約%@を解放しました。"
