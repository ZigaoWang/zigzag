    "You put it to sleep. Loads when you click it." : {
      "comment" : "Under a sleeping tab's title in its hover card, or its tooltip: you put it to sleep with Suspend Page in its menu, and its page loads again once you click it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von dir in den Ruhezustand versetzt. Wird geladen, wenn du darauf klickst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú la suspendiste. Se carga al hacer clic en ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous l’avez mis en veille. Se charge lorsque vous cliquez dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’hai sospeso tu. Si carica quando ci fai clic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動でスリープしました。クリックすると読み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자가 잠자기 상태로 전환했습니다. 클릭하면 로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt het in de slaapstand gezet. Het laadt wanneer je erop klikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uśpiona przez ciebie. Wczyta się po kliknięciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você a suspendeu. Ela carrega quando você clica nela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы перевели её в спящий режим. Загрузится по щелчку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz uykuya aldınız. Tıkladığınızda yüklenir."
          }
        },
        "zh-Hans" : {
