    "Allow in private windows affects only Open, not Save." : {
      "comment" : "Under the fields of a per-extension destination's sheet: the private-windows switch only stops Open, not Save.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„In privaten Fenstern erlauben“ gilt nur für „Öffnen“, nicht für „Sichern“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir en ventanas privadas solo afecta a Abrir, no a Guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser dans les fenêtres privées ne concerne que l’ouverture, pas l’enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti nelle finestre private riguarda solo Apri, non Salva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「プライベートウインドウで許可」は「開く」にのみ適用され、「保存」には適用されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘개인 정보 보호 윈도우에서 허용’은 열기에만 적용되며 저장에는 적용되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Toestaan in privévensters” heeft alleen invloed op Open, niet op Bewaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcja „Zezwalaj w oknach prywatnych” dotyczy tylko „Otwórz”, a nie „Zachowaj”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir em janelas privadas afeta apenas Abrir, não Salvar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Параметр «Разрешить в частных окнах» влияет только на «Открыть», но не на «Сохранить»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Özel pencerelerde izin ver” yalnızca Aç’ı etkiler, Kaydet’i etkilemez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“允许在无痕浏览窗口中使用”只影响“打开”，不影响“存储”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「允許在私密瀏覽視窗中使用」只影響「開啟」，不影響「儲存」。"
          }
        }
      }
    },
    "Allow it only if it needs this for what you just asked it to do." : {
      "comment" : "Under the title of the sheet shown when an extension asks for more access.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube es nur, wenn die Erweiterung es für das braucht, worum du sie gerade gebeten hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permítelo solo si lo necesita para lo que le acabas de pedir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez-la uniquement si elle en a besoin pour ce que vous venez de lui demander."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consentilo solo se ne ha bisogno per ciò che gli hai appena chiesto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直前に頼んだことのためにこのアクセスが必要な場合にのみ許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방금 요청한 작업에 필요한 경우에만 허용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta dit alleen toe als de extensie het nodig heeft voor wat je net hebt gevraagd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól tylko wtedy, gdy jest to potrzebne do tego, o co właśnie je poproszono."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita somente se ela precisar disso para o que você acabou de pedir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешайте, только если это нужно для того, о чём вы только что попросили."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca az önce yapmasını istediğiniz iş için buna ihtiyaç duyuyorsa izin verin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有当它需要这项权限来完成你刚才让它做的事时，才允许。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有當它需要這項權限來完成你剛剛讓它做的事時，才允許。"
          }
        }
      }
    },
