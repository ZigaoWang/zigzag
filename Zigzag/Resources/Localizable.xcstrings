          }
        }
      }
    },
    "Its settings and data on this Mac are deleted too. You can add it again from the Chrome Web Store." : {
      "comment" : "Message of the sheet that asks before removing an extension.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen und Daten der Erweiterung auf diesem Mac werden ebenfalls gelöscht. Du kannst sie im Chrome Web Store wieder hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se eliminan sus ajustes y datos en este Mac. Puedes volver a añadirla desde Chrome Web Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses réglages et ses données sur ce Mac sont également supprimés. Vous pourrez l’ajouter à nouveau depuis le Chrome Web Store."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche le sue impostazioni e i suoi dati su questo Mac vengono eliminati. Puoi aggiungerla di nuovo dal Chrome Web Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMac上の設定とデータも削除されます。Chromeウェブストアからもう一度追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에 있는 확장 프로그램의 설정과 데이터도 삭제됩니다. Chrome 웹 스토어에서 다시 추가할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De instellingen en gegevens op deze Mac worden ook verwijderd. Je kunt de extensie opnieuw toevoegen via de Chrome Web Store."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jego ustawienia i dane na tym Macu również zostaną usunięte. Możesz dodać je ponownie z Chrome Web Store."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ajustes e os dados dela neste Mac também são excluídos. Você pode adicioná-la novamente pela Chrome Web Store."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его настройки и данные на этом Mac тоже удаляются. Вы можете добавить его снова из Chrome Web Store."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac’teki ayarları ve verileri de silinir. Chrome Web Store’dan yeniden ekleyebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它在这台 Mac 上的设置和数据也会被删除。你可以从 Chrome 网上应用店重新添加它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它在這台 Mac 上的設定和資料也會被刪除。你可以從 Chrome 線上應用程式商店重新新增它。"
          }
        }
      }
    },
    "Its sign-ins, history, favorites and extensions are deleted, with everything the extensions hold, wallets included." : {
      "comment" : "Message of the sheet that deletes a profile. More sentences may follow.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Anmeldungen, sein Verlauf, seine Favoriten und Erweiterungen werden gelöscht, mit allem, was die Erweiterungen enthalten, Wallets eingeschlossen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan sus inicios de sesión, historial, favoritos y extensiones, con todo lo que guardan las extensiones, carteras incluidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses connexions, son historique, ses favoris et ses extensions sont supprimés, avec tout ce que contiennent les extensions, portefeuilles compris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessi, cronologia, preferiti ed estensioni vengono eliminati, insieme a tutto ciò che le estensioni contengono, wallet inclusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン状態、履歴、お気に入り、機能拡張が削除され、機能拡張が保存しているすべてのデータ（ウォレットを含む）も削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 상태, 방문 기록, 즐겨찾기, 확장 프로그램이 지갑을 포함해 확장 프로그램에 보관된 모든 항목과 함께 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De aanmeldingen, geschiedenis, favorieten en extensies worden verwijderd, met alles wat de extensies bevatten, inclusief wallets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jego logowania, historia, ulubione i rozszerzenia zostaną usunięte wraz ze wszystkim, co przechowują rozszerzenia, łącznie z portfelami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os logins, o histórico, os favoritos e as extensões dele são excluídos, com tudo o que as extensões guardam, inclusive carteiras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его входы, история, избранное и расширения удаляются вместе со всем, что хранят расширения, включая кошельки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Girişleri, geçmişi, favorileri ve genişletmeleri, genişletmelerin sakladığı her şeyle birlikte (cüzdanlar dahil) silinir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的登录状态、历史记录、收藏和扩展都会被删除，扩展保存的所有内容（包括钱包）也会一并删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的登入狀態、瀏覽記錄、收藏和延伸功能都會被刪除，延伸功能儲存的所有內容（包括錢包）也會一併刪除。"
          }
        }
      }
    },
    "Its spaces move to %@." : {
      "comment" : "Added to the message of the sheet that deletes a profile, when the profile has spaces. The placeholder is the first profile's name.",
      "localizations" : {
        "de" : {
