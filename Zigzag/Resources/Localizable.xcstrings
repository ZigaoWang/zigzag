    },
    "%@: in its settings, choose Browser, then Add Browser" : {
      "comment" : "Toast when an extension needs a step in its own app. The placeholder is a title like “Connect 1Password to Zigzag”. Browser and Add Browser are names in 1Password's settings.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：在其设置中选取“浏览器”，然后选取“添加浏览器”"
          }
        }
      }
    },
    "%@: needs attention" : {
      "comment" : "Tooltip of an extension's button in the site panel when the extension asks for attention. The name is the extension's.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：需要你留意"
          }
        }
      }
    },
    "%@: no shortcut" : {
      "comment" : "Accessibility label of a command with no keys in Settings › Shortcuts.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：无快捷键"
          }
        }
      }
    },
    "%@: page" : {
      "comment" : "The address bar's name for a page with no site, like a data: page. The placeholder is the address's scheme, like “data”.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：页面"
          }
        }
      }
    },
    "%@?" : {
      "comment" : "A site's permission question: the request, then a question mark, like “Use your camera?”.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@？"
          }
        }
      }
    },
    "%@’s page is using a lot of energy" : {
      "comment" : "Toast when an extension's own page uses a lot of energy. The name is the extension's.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的页面耗电较多"
          }
        }
      }
    },
    "%@’s passwords and sign-ins stayed locked. Click Try Again, type your Mac’s password when macOS asks, and click Always Allow." : {
      "comment" : "Problem in the Import window. The placeholder is a browser's name, like Chrome; Try Again is a button here, Always Allow is macOS's own button.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的密码和登录状态仍处于锁定状态。请点按“再试一次”，在 macOS 询问时输入你的 Mac 密码，然后点按“始终允许”。"
          }
        }
      }
    },
