    "At most %lld pins. Unpin one first." : {
      "comment" : "Tooltip of the disabled Pin to Address item in an extension's menu, when the most extensions that can be pinned already are. The number is that limit.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchstens %lld fixierte Erweiterungen. Löse zuerst eine."
          }
