            "value" : "Токены: {link}, {encoded_link}, {host}, {path}, {query}, {referrer}, {cookies}, {cookie_header}, {filename}, {mime}, {space}, {file}, {file_url}, {file_raw}. Для {file}, {file_url} и {file_raw} нужна передача файла; {file_raw} — содержимое файла, для параметров сервиса."
          }
        },
        "tr" : {
