          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag darf in diesem Ordner nicht sichern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag no tiene permiso para guardar en esa carpeta"
          }
        },
