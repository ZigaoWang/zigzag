        }
      }
    },
    "It may need more memory than your Mac can spare right now. Close some tabs, then try again." : {
      "comment" : "Message on the page Zigzag shows when a page can't load.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
