    "The site may be down right now. Try again in a moment." : {
      "comment" : "Message on the page Zigzag shows when a page can't load.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Website ist gerade vielleicht nicht erreichbar. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que el sitio esté caído ahora mismo. Inténtalo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le site est peut-être indisponible pour le moment. Réessayez dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sito potrebbe non essere disponibile in questo momento. Riprova tra poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイトが現在ダウンしている可能性があります。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사이트가 지금 작동하지 않을 수 있습니다. 잠시 후에 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De website is mogelijk offline. Probeer het zo opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witryna może być teraz niedostępna. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O site pode estar fora do ar agora. Tente novamente em instantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможно, сайт сейчас недоступен. Повторите попытку через минуту."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Site şu anda kapalı olabilir. Biraz sonra yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网站现在可能无法访问。请稍后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前可能無法連上此網站。請稍後再試。"
          }
        }
      }
    },
    "The site only opens for Macs with a certificate it trusts, often one from work or school." : {
      "comment" : "Message on the page Zigzag shows when a page can't load.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Website öffnet sich nur für Macs mit einem Zertifikat, dem sie vertraut, oft einem von der Arbeit oder der Schule."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sitio solo se abre en Macs con un certificado en el que confía, a menudo uno del trabajo o de la escuela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le site ne s’ouvre que pour les Mac disposant d’un certificat qu’il approuve, souvent fourni par votre travail ou votre établissement scolaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sito si apre solo per i Mac con un certificato di cui si fida, spesso uno del lavoro o della scuola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサイトは、信頼する証明書（多くは職場や学校のもの）を持つMacでしか開けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사이트는 신뢰하는 인증서가 있는 Mac에서만 열립니다. 대개 직장이나 학교의 인증서입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De website opent alleen voor Macs met een certificaat dat hij vertrouwt, vaak een certificaat van werk of school."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witryna otwiera się tylko na Macach z certyfikatem, któremu ufa, często z pracy lub szkoły."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O site só abre para Macs com um certificado em que ele confia, muitas vezes um do trabalho ou da escola."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сайт открывается только для компьютеров Mac с сертификатом, которому он доверяет, часто это сертификат с работы или из учебного заведения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Site yalnızca güvendiği bir sertifikası olan Mac’ler için açılır, çoğu zaman iş veya okuldan alınan bir sertifika."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该网站只对带有它信任的证书的 Mac 开放，这种证书通常来自工作单位或学校。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該網站只對帶有它信任的憑證的 Mac 開放，這種憑證通常來自工作單位或學校。"
          }
        }
      }
    },
    "The site refused it" : {
      "comment" : "Why a download failed, under its name in the downloads panel.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Website hat die Datei verweigert"
          }
        },
