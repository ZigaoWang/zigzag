    "Smoke" : {
      "comment" : "Name of a curated space color, in the space editor. A deep smoked graphite glass.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "烟灰"
          }
        }
      }
    },
    "Never Translate" : {
      "comment" : "A heading in Settings › Translation, over the languages and sites never offered or translated on their own.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永不翻译"
          }
        }
      }
    },
    "Never Translate %@" : {
      "comment" : "Item in the translate menu: pages in this language are never offered or translated on their own. The name is a language's, like French.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永不翻译%@"
