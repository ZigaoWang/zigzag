            "value" : "Tokeny: {link}, {encoded_link}, {host}, {path}, {query}, {referrer}, {cookies}, {cookie_header}, {filename}, {mime}, {space}, {file}, {file_url}, {file_raw}. Tokeny {file}, {file_url} i {file_raw} wymagają przekazania pliku; {file_raw} to zawartość pliku, do parametrów usługi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens: {link}, {encoded_link}, {host}, {path}, {query}, {referrer}, {cookies}, {cookie_header}, {filename}, {mime}, {space}, {file}, {file_url}, {file_raw}. {file}, {file_url} e {file_raw} exigem entrega de arquivo; {file_raw} é o conteúdo do arquivo, para os parâmetros de um serviço."
          }
        },
        "ru" : {
          "stringUnit" : {
