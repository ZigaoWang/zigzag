      "comment" : "Under a tab's title in its hover card, or a favorite's tooltip: the tab came back after Zigzag was quit and opened again, and its page loads only once you click it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit dem Neustart von Zigzag nicht geladen. Wird geladen, wenn du darauf klickst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cargar desde que se reabrió Zigzag. Se carga al hacer clic en ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non chargé depuis la réouverture de Zigzag. Se charge lorsque vous cliquez dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non caricato da quando Zigzag è stato riaperto. Si carica quando ci fai clic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzagを再度開いてから読み込まれていません。クリックすると読み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag를 다시 연 후 로드되지 않았습니다. 클릭하면 로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet geladen sinds Zigzag opnieuw is geopend. Laadt wanneer je erop klikt."
          }
        },
        "pl" : {
          "stringUnit" : {
