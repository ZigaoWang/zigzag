    "When off, Zigzag still checks and asks before downloading an update." : {
      "comment" : "Explanation under “Install updates automatically” in Settings › General.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist die Option aus, sucht Zigzag weiterhin nach Updates und fragt vor dem Laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con esto desactivado, Zigzag sigue comprobando y pregunta antes de descargar una actualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est désactivée, Zigzag recherche quand même les mises à jour et vous demande avant d’en télécharger une."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se disattivato, Zigzag controlla comunque e chiede prima di scaricare un aggiornamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにしても、Zigzagはアップデートを確認し、ダウンロードする前に尋ねます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄더라도 Zigzag는 계속 업데이트를 확인하며, 다운로드하기 전에 묻습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit uit staat, zoekt Zigzag nog steeds naar updates en vraagt het voordat het een update downloadt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy opcja jest wyłączona, Zigzag nadal sprawdza i pyta przed pobraniem aktualizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com isto desativado, o Zigzag ainda busca atualizações e pergunta antes de baixar uma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если выключить, Zigzag всё равно проверяет обновления и спрашивает перед загрузкой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalıyken Zigzag yine de denetler ve güncellemeyi indirmeden önce sorar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
