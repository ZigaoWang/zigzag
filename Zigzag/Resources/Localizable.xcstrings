    "That’s every port of %@, not only %@." : {
      "comment" : "Added to the message of the sheet that asks before clearing one site's cache or cookies, on a development site whose address has a port, like localhost:3000. The first placeholder is the site, the second the port's number.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das umfasst alle Ports von %1$@, nicht nur %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That’s every port of %1$@, not only %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto incluye todos los puertos de %1$@, no solo %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela concerne %1$@ sur tous ses ports, pas seulement le port %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale per ogni porta di %@, non solo per %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@だけでなく、%1$@のすべてのポートが対象です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@번 포트뿐 아니라 %1$@의 모든 포트에 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat is elke poort van %1$@, niet alleen %2$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To każdy port witryny %1$@, nie tylko %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "São todas as portas de %1$@, não só %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это все порты %1$@, а не только %2$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, yalnızca %2$@ için değil, %1$@ sitesinin her bağlantı noktası için geçerlidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会清除 %1$@ 的所有端口，而不只是 %2$@。"
