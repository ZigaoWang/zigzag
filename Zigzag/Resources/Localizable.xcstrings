            "value" : "The background page (Manifest V2 only; Manifest V3 pages get “You do not have a background page.”)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La página en segundo plano (solo Manifest V2; las páginas de Manifest V3 reciben “You do not have a background page.”)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La page d’arrière-plan (Manifest V2 uniquement ; les pages Manifest V3 reçoivent « You do not have a background page. »)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pagina in background (solo Manifest V2; le pagine Manifest V3 ricevono “You do not have a background page.”)"
          }
        },
        "ja" : {
          "stringUnit" : {
