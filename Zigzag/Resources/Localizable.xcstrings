    },
    "This page was reloaded because it was using a lot of memory" : {
      "comment" : "Toast after a page loaded again because WebKit ended it for using too much memory.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
