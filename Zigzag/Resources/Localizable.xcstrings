    "%@ of %@" : {
      "comment" : "Under a download's name in the downloads panel: how much has come of how much, like 3.7 MB of 9 MB.\nUnder a download's name in the downloads panel: how much has come of how much, the unit said once, like 3.7 of 9 MB.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ playing audio" : {
      "comment" : "Spoken by VoiceOver after a tab row's name, for one page of a split: that page's title, then that it plays sound.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，正在播放音频"
          }
        }
      }
    },
    "%@ says" : {
      "comment" : "Title of a page's JavaScript alert, confirm or prompt sheet. The placeholder is the site's host name, or “This page”.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 提示"
          }
        }
      }
    },
    "%@ sent a broken page" : {
      "comment" : "Title of the page Zigzag shows when a page can't load. The placeholder is the site's host name.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 发来的页面已损坏"
          }
        }
      }
    },
    "%@ side panel" : {
      "comment" : "What VoiceOver calls an extension's side panel. The placeholder is the extension's name.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 边栏面板"
          }
        }
      }
    },
    "%@ stays pinned to its own page" : {
      "comment" : "Toast after closing a pinned tab that had wandered to another page. The title is the pinned tab's.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”会固定在它自己的页面上"
          }
        }
      }
    },
    "%@ to %@" : {
      "comment" : "The time a session or a site's pages span on the History page, like “2:10 to 4:45 PM”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ to %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 至 %2$@"
          }
        }
      }
    },
    "%@ took too long" : {
      "comment" : "Title of the page Zigzag shows when a page can't load. The placeholder is the site's host name.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 响应时间过长"
          }
        }
      }
    },
    "%@ wants a certificate" : {
      "comment" : "Title of the page Zigzag shows when a page can't load. The placeholder is the site's host name.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 要求提供证书"
          }
        }
      }
    },
    "%@ wants more access" : {
      "comment" : "Title of the sheet shown when an extension's update asks for more access. The name is the extension's.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 请求更多权限"
          }
        }
      }
    },
    "%@ works together with an app on your Mac, and Zigzag couldn’t find it. Install the app, then reopen Zigzag." : {
      "comment" : "Shown from an extension's button when its companion app isn't installed. The placeholder is the extension's name.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 需要配合 Mac 上的一个 App 使用，但 Zigzag 找不到它。请安装该 App，然后重新打开 Zigzag。"
          }
        }
      }
    },
    "%@, %@" : {
      "comment" : "Accessibility label of the address in the sidebar on a plain http page: the site, then that it's not secure.\nUnder a download's name in the downloads panel: how much has come, then the time left, like 3.7 of 9 MB, a minute left.\nVoiceOver name of a command bar result: its title, then what's under it.\nVoiceOver name of a download in the downloads panel: the file's name, then what's under it.\nWhat VoiceOver says for a row in the Passwords window: the site, then the username.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，%2$@"
          }
        }
      }
    },
    "%@, %lld percent color" : {
      "comment" : "VoiceOver, in the space editor's color wheel: a knob's color family, then how much color, like “Blue, 40 percent color”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$lld percent color"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，色彩 %2$lld%%"
          }
        }
      }
    },
    "%@, by %@" : {
      "comment" : "Under an article's title in Reader: the site it's from, then who wrote it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, by %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，作者：%2$@"
          }
        }
      }
    },
    "%@, current space" : {
      "comment" : "Spoken by VoiceOver as the space switcher's choice moves to the space you're in. The placeholder is its name.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，当前空间"
          }
        }
      }
    },
    "%@, folder, %lld pinned" : {
      "comment" : "Accessibility label of a folder in the sidebar: its name, then how many pinned tabs it holds.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, folder, %2$lld pinned"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，文件夹，%2$lld 个已固定"
          }
        }
      }
    },
    "%@, pinned tabs hidden" : {
      "comment" : "Accessibility label of the space's name above its pinned tabs, while they're folded away.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，已固定标签页已隐藏"
          }
        }
      }
    },
    "%@, split with %@" : {
      "comment" : "Accessibility label of a split view's row in the sidebar: the two pages' titles.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, split with %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，与 %2$@ 分屏"
          }
        }
      }
    },
    "%@. %@." : {
      "comment" : "A save that failed, then why, as two sentences: “Couldn’t save the page. Not enough space on your Mac.”",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@。%2$@。"
          }
        }
      }
    },
    "%@: %@" : {
      "comment" : "Accessibility label of a shortcut in Settings › Shortcuts: the command, then its keys.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
