        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-apps gebruiken dit profiel wanneer ze op de achtergrond draaien. De naam kan niet worden gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje AI używają tego profilu, gdy działają w tle. Nie można zmienić jego nazwy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps de IA usam este perfil quando são executados em segundo plano. O nome dele não pode ser alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ИИ-приложения используют этот профиль при работе в фоновом режиме. Его имя изменить нельзя."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zekâ uygulamaları arka planda çalışırken bu profili kullanır. Adı değiştirilemez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 应用在后台运行时使用此个人资料。它的名称无法更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI App 在背景執行時使用這個個人資料。它的名稱無法更改。"
          }
        }
      }
    },
    "AI apps work in it. Zigzag never saves or fills passwords here, nor fills forms from your card." : {
      "comment" : "Explanation under “Not used in this profile” in Settings › Passwords, with the profile AI apps use in the background chosen.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier arbeiten KI-Apps. Zigzag sichert hier nie Passwörter, füllt keine aus und füllt keine Formulare mit deiner Karte aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps de IA trabajan en él. Zigzag nunca guarda ni rellena contraseñas aquí, ni rellena formularios con tu tarjeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps d’IA y travaillent. Zigzag n’y enregistre ni ne remplit jamais de mots de passe, et ne remplit pas les formulaires à partir de votre fiche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app IA lavorano al suo interno. Qui Zigzag non salva né compila mai le password, e non compila i moduli con la tua scheda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Appがここで作業します。このプロファイルでは、Zigzagはパスワードの保存や入力、カードからのフォーム入力を行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 앱이 이 프로필에서 작업합니다. Zigzag는 여기에서 암호를 저장하거나 채우지 않으며, 나의 카드로 양식을 채우지도 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-apps werken erin. Zigzag bewaart hier nooit wachtwoorden en vult ze niet in, en vult ook geen formulieren in met je kaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje AI w nim pracują. Zigzag nigdy nie zachowuje ani nie wypełnia tu haseł ani nie wypełnia formularzy danymi z karty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps de IA trabalham nele. O Zigzag nunca salva nem preenche senhas aqui, nem preenche formulários com seu cartão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ИИ-приложения работают в нём. Zigzag здесь не сохраняет и не подставляет пароли и не заполняет формы из вашей карточки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zekâ uygulamaları burada çalışır. Zigzag burada parolaları hiçbir zaman kaydetmez veya doldurmaz, formları da kartınızdan doldurmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 应用在其中工作。Zigzag 绝不会在这里存储或填写密码，也不会用“我的名片”填写表单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI App 在這裡工作。Zigzag 絕不會在這裡儲存或填寫密碼，也不會用「我的名片」填寫表單。"
          }
        }
      }
    },
