    "The iCloud Passwords extension is installed too. You can remove it in Settings › Extensions." : {
      "comment" : "Under “Password manager” in Settings › Passwords, with Zigzag chosen while Apple's iCloud Passwords extension is still installed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erweiterung „iCloud-Passwörter“ ist ebenfalls installiert. Du kannst sie unter „Einstellungen“ › „Erweiterungen“ entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La extensión Contraseñas de iCloud también está instalada. Puedes quitarla en Ajustes › Extensiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’extension Mots de passe iCloud est également installée. Vous pouvez la supprimer dans Réglages › Extensions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È installata anche l’estensione Password di iCloud. Puoi rimuoverla in Impostazioni › Estensioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudパスワード機能拡張もインストールされています。「設定 › 機能拡張」で削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 암호 확장 프로그램도 설치되어 있습니다. 설정 › 확장 프로그램에서 제거할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De extensie iCloud-wachtwoorden is ook geïnstalleerd. Je kunt die verwijderen in Instellingen › Extensies."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozszerzenie Hasła iCloud jest również zainstalowane. Możesz je usunąć w „Ustawienia” › „Rozszerzenia”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A extensão Senhas do iCloud também está instalada. Você pode removê-la em Ajustes › Extensões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расширение «Пароли iCloud» тоже установлено. Его можно удалить в разделе «Настройки» › «Расширения»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Parolaları genişletmesi de yüklü. Ayarlar › Genişletmeler bölümünden kaldırabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 密码扩展也已安装，你可以在“设置 › 扩展”中移除它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 密碼延伸功能也已安裝，你可以在「設定 › 延伸功能」中移除它。"
          }
        }
      }
    },
    "The language you read." : {
      "comment" : "Explanation under “Translate pages into” in Settings › Translation.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
