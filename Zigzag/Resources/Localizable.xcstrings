            "value" : "O que isto permite…"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что это разрешает…"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunun İzin Verdikleri…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
