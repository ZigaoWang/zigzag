    "Trusted Certificates" : {
      "comment" : "A heading in Settings › Developer: local servers whose certificate you chose to trust, so Zigzag doesn’t warn again.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertrauenswürdige Zertifikate"
          }
        },
        "es" : {
