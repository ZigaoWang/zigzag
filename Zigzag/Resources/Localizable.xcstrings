            "state" : "translated",
            "value" : "El grupo se fija en %@ como carpeta, con todas sus pestañas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le groupe est épinglé dans %@ en tant que dossier, avec tous ses onglets."
