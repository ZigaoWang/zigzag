          }
        }
      }
    },
    "The site refused it" : {
      "comment" : "Why a download failed, under its name in the downloads panel.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网站拒绝了该请求"
