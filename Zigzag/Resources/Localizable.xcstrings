    "Websites without a dark look of their own are drawn dark. Pictures and video stay as they are." : {
      "comment" : "Explanation under “Dark pages” in Settings › Appearance.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites ohne eigenen Dunkelmodus werden dunkel dargestellt. Bilder und Videos bleiben unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sitios web sin un aspecto oscuro propio se muestran oscuros. Las imágenes y los vídeos se quedan como están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sites web qui n’ont pas leur propre apparence sombre sont affichés en sombre. Les images et les vidéos restent inchangées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I siti web senza un aspetto scuro proprio vengono mostrati scuri. Immagini e video restano come sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "独自のダークな外観がないWebサイトを暗く表示します。画像とビデオはそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다크 모양을 제공하지 않는 웹 사이트를 어둡게 표시합니다. 이미지와 비디오는 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites zonder eigen donkere weergave worden donker weergegeven. Afbeeldingen en video blijven zoals ze zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witryny bez własnego ciemnego wyglądu są rysowane na ciemno. Obrazy i wideo pozostają bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sites sem visual escuro próprio são exibidos em escuro. Imagens e vídeos continuam como estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сайты без собственной тёмной темы отображаются тёмными. Изображения и видео не меняются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
