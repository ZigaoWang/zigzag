    "Write down any recovery phrases first. This can’t be undone." : {
      "comment" : "Ends the message of the sheet that deletes a profile: a wallet extension's recovery phrase is the only way back to it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notiere dir zuerst alle Wiederherstellungsphrasen. Dies kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota antes las frases de recuperación. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
