    "Not unlocked. Try again when you’re ready." : {
      "comment" : "Shown in the locked Passwords window after Touch ID was cancelled or failed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht entsperrt. Versuche es erneut, wenn du so weit bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se desbloqueó. Inténtalo de nuevo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non déverrouillé. Réessayez quand vous êtes prêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sbloccato. Riprova quando vuoi."
