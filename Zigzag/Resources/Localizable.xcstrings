      }
    },
    "Every flag you changed goes back to WebKit’s default, for pages you open or reload." : {
      "comment" : "Message of the sheet that puts every WebKit feature flag back to its default.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes geänderte Flag wird auf den WebKit-Standard zurückgesetzt, für Seiten, die du öffnest oder neu lädst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los indicadores que cambiaste vuelven al valor predeterminado de WebKit, para las páginas que abras o recargues."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque indicateur modifié reprend sa valeur WebKit par défaut, pour les pages que vous ouvrez ou rechargez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
