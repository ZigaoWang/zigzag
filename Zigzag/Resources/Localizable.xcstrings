    "After you close a pinned tab that went to another page, like a new chat." : {
      "comment" : "Explanation under “Offer to pin the page you moved to” in Settings › Tabs.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachdem du einen fixierten Tab geschlossen hast, der zu einer anderen Seite gewechselt ist, etwa zu einem neuen Chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras cerrar una pestaña fijada que fue a otra página, como un chat nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous fermez un onglet épinglé qui a changé de page, par exemple pour une nouvelle conversation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando chiudi un pannello fissato che è passato a un’altra pagina, ad esempio una nuova chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のページ（新しいチャットなど）に移動した固定タブを閉じたときに表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 채팅처럼 다른 페이지로 이동한 고정된 탭을 닫은 후에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadat je een vastgezet tabblad sluit dat naar een andere pagina ging, zoals een nieuwe chat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zamknięciu przypiętej karty, która przeszła na inną stronę, na przykład nowy czat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois que você fecha uma aba fixada que foi para outra página, como um novo chat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После закрытия закреплённой вкладки, перешедшей на другую страницу, например в новый чат."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabitlenmiş bir sekmeyi, yeni bir sohbet gibi başka bir sayfaya gittikten sonra kapattığınızda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定标签页跳到了别的页面（比如新对话）时，关闭它会提示你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定分頁跳到了別的網頁（例如新對話）時，關閉它會提示你。"
          }
        }
      }
    },
    "After you sign in. Kept in your Keychain, synced with iCloud." : {
      "comment" : "Explanation under “Offer to save passwords” in Settings › Passwords.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Anmeldung. Im Schlüsselbund gesichert und mit iCloud synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de iniciar sesión. Se guarda en tu llavero y se sincroniza con iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après votre connexion. Conservés dans votre trousseau, synchronisés avec iCloud."
          }
        },
        "it" : {
