    "Clear Cookies… and quitting leave its cookies alone, on http and https and every subdomain, so you stay signed in." : {
      "comment" : "Under the title of the sheet that adds a site whose cookies are kept, from Settings › Privacy.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Cookies löschen …“ und das Beenden lassen ihre Cookies unangetastet, für http und https und alle Subdomains, damit du angemeldet bleibst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borrar cookies… y salir no tocan sus cookies, en http y https y en todos los subdominios, para que sigas con la sesión iniciada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effacer les cookies… et la fermeture de Zigzag laissent ses cookies intacts, en http et https et sur tous ses sous-domaines, pour que vous restiez connecté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Né Cancella cookie… né l’uscita da Zigzag toccano i suoi cookie, su http e https e su ogni sottodominio, così resti connesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Cookieを消去…」を使ったときやZigzagを終了したときも、このサイトのCookieはhttp、https、すべてのサブドメインで消去されないため、ログインしたままでいられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘쿠키 지우기…’를 사용하거나 종료해도 http와 https 및 모든 하위 도메인에서 이 사이트의 쿠키는 그대로 유지되므로 로그인 상태가 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Wis cookies…” en het stoppen van Zigzag laten de cookies ongemoeid, op http en https en elk subdomein, zodat je aangemeld blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ani polecenie „Wyczyść pliki cookie…”, ani zakończenie pracy Zigzag nie usuwają jej plików cookie (http i https, wszystkie subdomeny), więc logowanie zostaje zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpar cookies… e encerrar o Zigzag não afetam os cookies desse site, em http, https e todos os subdomínios, então você continua conectado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Очистить cookie…» и выход не затрагивают его cookie на http, https и во всех поддоменах, поэтому вы остаётесь в системе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Çerezleri Temizle…” ve çıkış, sitenin çerezlerine dokunmaz: http ve https üzerinde ve her alt alan adında, böylece oturumunuz açık kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“清除 Cookie…”和退出时都不会清除它的 Cookie，http、https 和所有子域名都包括在内，让你保持登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「清除 Cookie…」和結束時都不會清除它的 Cookie，http、https 和所有子網域都包括在內，讓你保持登入。"
          }
        }
      }
    },
