    },
    "Zigzag can’t read your card. Allow it in System Settings › Privacy › Contacts, and set My Card in Contacts." : {
      "comment" : "Toast when filling a form from Contacts isn't allowed. System Settings › Privacy › Contacts and My Card are names macOS uses; match them.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag kann deine Karte nicht lesen. Erlaube es unter „Systemeinstellungen“ › „Datenschutz & Sicherheit“ › „Kontakte“ und lege in den Kontakten „Meine Karte“ fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag no puede leer tu tarjeta. Permítelo en Ajustes del Sistema › Privacidad y seguridad › Contactos y define Mi tarjeta en Contactos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag ne peut pas lire votre fiche. Autorisez-le dans Réglages Système › Confidentialité et sécurité › Contacts, et définissez Ma fiche dans Contacts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag non riesce a leggere la tua scheda. Consenti l’accesso in Impostazioni di Sistema › Privacy e sicurezza › Contatti e imposta La mia scheda in Contatti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzagは自分のカードを読み込めません。「システム設定 › プライバシーとセキュリティ › 連絡先」で許可し、連絡先で自分のカードを設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag가 나의 카드를 읽을 수 없습니다. 시스템 설정 › 개인정보 보호 › 연락처에서 허용하고 연락처에서 나의 카드를 설정하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag kan je kaart niet lezen. Sta het toe in Systeeminstellingen › Privacy en beveiliging › Contacten en stel Mijn kaart in via Contacten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag nie może odczytać twojej karty. Zezwól na to w „Ustawienia systemowe” › „Prywatność i ochrona” › „Kontakty” i ustaw „Moja karta” w Kontaktach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zigzag não consegue ler seu cartão. Permita em Ajustes do Sistema › Privacidade e Segurança › Contatos e defina Meu Cartão em Contatos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag не может прочитать вашу карточку. Разрешите это в разделе «Системные настройки» › «Конфиденциальность и безопасность» › «Контакты» и задайте «Мою карточку» в «Контактах»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag kartınızı okuyamıyor. Sistem Ayarları › Gizlilik ve Güvenlik › Kişiler’de buna izin verin ve Kişiler’de Kartım’ı ayarlayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 无法读取你的名片。请在“系统设置 › 隐私与安全性 › 通讯录”中允许访问，并在“通讯录”中设置“我的名片”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 無法讀取你的名片。請在「系統設定 › 隱私權與安全性 › 聯絡人」允許存取，並在「聯絡人」中設定「我的名片」。"
          }
        }
      }
    },
    "Zigzag couldn’t find a password field it can see on this page. Copy the password from Passwords instead." : {
      "comment" : "Toast when a login or strong password was picked but the page has no visible password field to put it in. Passwords is the window.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag hat auf dieser Seite kein sichtbares Passwortfeld gefunden. Kopiere das Passwort stattdessen aus „Passwörter“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag no encontró un campo de contraseña visible en esta página. Copia la contraseña desde Contraseñas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag n’a trouvé aucun champ de mot de passe visible sur cette page. Copiez plutôt le mot de passe depuis Mots de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag non ha trovato un campo password visibile in questa pagina. Copia invece la password da Password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このページに表示されているパスワードフィールドが見つかりませんでした。代わりに「パスワード」からパスワードをコピーしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag가 이 페이지에서 보이는 암호 필드를 찾을 수 없습니다. 대신 암호 윈도우에서 암호를 복사하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag kon geen wachtwoordveld vinden dat het op deze pagina kan zien. Kopieer het wachtwoord in plaats daarvan uit Wachtwoorden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag nie znalazł widocznego pola hasła na tej stronie. Skopiuj hasło z okna haseł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zigzag não encontrou um campo de senha visível nesta página. Copie a senha de Senhas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag не нашёл на этой странице видимое поле пароля. Скопируйте пароль из окна «Пароли»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag bu sayfada görebildiği bir parola alanı bulamadı. Bunun yerine parolayı Parolalar’dan kopyalayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 在这个页面上找不到看得见的密码框。请到“密码”里拷贝密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 在這個網頁上找不到看得見的密碼框。請到「密碼」裡複製密碼。"
          }
        }
      }
    },
    "Zigzag couldn’t find fields for your card that it can see here." : {
      "comment" : "Toast when Fill from My Card was picked but no visible name, email, phone or address field on the page could take it. My Card is the person's own card in Contacts, as macOS calls it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag hat hier keine sichtbaren Felder für deine Karte gefunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag no encontró campos visibles para tu tarjeta aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag n’a trouvé ici aucun champ visible pour votre fiche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag non ha trovato qui campi visibili da compilare con la tua scheda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここに表示されている、カードの情報を入力できるフィールドが見つかりませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag가 여기에서 나의 카드 정보를 채울 수 있는 보이는 필드를 찾을 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag kon geen velden vinden voor je kaart die het hier kan zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag nie znalazł widocznych tu pól dla twojej karty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zigzag não encontrou campos visíveis aqui para o seu cartão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag не нашёл здесь видимых полей для вашей карточки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag burada kartınız için görebildiği alanlar bulamadı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 在这里找不到看得见的、能填写名片信息的输入框。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 在這裡找不到看得見的、能填寫名片資訊的輸入欄位。"
          }
        }
      }
    },
    "Zigzag couldn’t move it to the Trash. Show it in Finder and delete it there." : {
      "comment" : "Import window, when the exported passwords file couldn't be moved to the Trash.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag konnte die Datei nicht in den Papierkorb legen. Zeige sie im Finder und lösche sie dort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag no pudo moverlo a la papelera. Muéstralo en el Finder y elimínalo allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag n’a pas pu le placer dans la corbeille. Affichez-le dans le Finder et supprimez-le depuis le Finder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag non è riuscito a spostarlo nel Cestino. Mostralo nel Finder ed eliminalo da lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゴミ箱に入れられませんでした。Finderに表示して、そこで削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag가 파일을 휴지통으로 이동할 수 없습니다. Finder에서 보기를 선택해 직접 삭제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag kon het niet naar de prullenmand verplaatsen. Toon het in de Finder en verwijder het daar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag nie mógł przenieść go do Kosza. Pokaż go w Finderze i usuń tam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zigzag não conseguiu movê-lo para o Lixo. Mostre-o no Finder e exclua-o lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag не удалось переместить файл в Корзину. Покажите его в Finder и удалите там."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag onu Çöp Sepeti’ne taşıyamadı. Finder’da gösterip orada silin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 未能将它移到废纸篓。请在“访达”中显示它，然后在那里删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 無法將它移到垃圾桶。請在 Finder 中顯示並刪除它。"
          }
        }
      }
    },
    "Zigzag couldn’t open %@’s passwords. Quit %@, then try again." : {
      "comment" : "Problem in the Import window. The placeholder is a browser's name, like Chrome.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag konnte die Passwörter von %1$@ nicht öffnen. Beende %2$@ und versuche es erneut."
