    "Off while %@ handles passwords. Turn on to use both." : {
      "comment" : "Under a password setting in Settings › Passwords, while a password manager extension (its name, like 1Password) is on.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus, solange %@ die Passwörter verwaltet. Schalte die Option ein, um beide zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado mientras %@ gestiona las contraseñas. Actívalo para usar ambos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : %@ gère les mots de passe. Activez-le pour utiliser les deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivata mentre %@ gestisce le password. Attivala per usarli entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@がパスワードを管理しているためオフです。両方使うにはオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 암호를 처리하는 동안 꺼져 있습니다. 둘 다 사용하려면 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uit zolang %@ wachtwoorden beheert. Zet aan om beide te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączone, gdy hasłami zarządza %@. Włącz, aby używać obu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado enquanto %@ gerencia as senhas. Ative para usar os dois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключено, пока %@ управляет паролями. Включите, чтобы использовать оба."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ parolaları yönetirken kapalı. İkisini birden kullanmak için açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 管理密码时此项关闭。打开即可同时使用两者。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 管理密碼時此項關閉。開啟即可同時使用兩者。"
          }
        }
      }
    },
    "Off, so nothing fills passwords." : {
      "comment" : "Under “iCloud Passwords extension” in Settings › Passwords, when the extension is turned off.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus, daher füllt nichts Passwörter aus."
          }
