    "AI apps can’t use Zigzag now. Turn them back on in Settings › Automation." : {
      "comment" : "Toast after Stop on the bar over a tab an AI app was using: every AI app is cut off until the setting is turned on again.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-Apps können Zigzag jetzt nicht verwenden. Schalte sie unter „Einstellungen“ › „Automation“ wieder ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps de IA ya no pueden usar Zigzag. Vuelve a activarlas en Ajustes › Automatización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps d’IA ne peuvent plus utiliser Zigzag. Réactivez-les dans Réglages › Automatisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app IA non possono più usare Zigzag. Riattivale in Impostazioni › Automazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI AppはZigzagを使えなくなりました。「設定 › オートメーション」で再びオンにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 AI 앱이 Zigzag를 사용할 수 없습니다. 설정 › 자동화에서 다시 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-apps kunnen Zigzag nu niet gebruiken. Zet ze weer aan in Instellingen › Automatisering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje AI nie mogą teraz używać Zigzag. Włącz je ponownie w „Ustawienia” › „Automatyzacja”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os apps de IA não podem usar o Zigzag agora. Ative-os novamente em Ajustes › Automação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ИИ-приложения теперь не могут использовать Zigzag. Включите их снова в разделе «Настройки» › «Автоматизация»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zekâ uygulamaları artık Zigzag’i kullanamaz. Ayarlar › Otomasyon bölümünden yeniden açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI App 现在不能使用 Zigzag 了。可在“设置 › 自动化”中重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI App 現在不能使用 Zigzag 了。可在「設定 › 自動化」中重新開啟。"
          }
        }
      }
    },
    "About Match Types" : {
      "comment" : "Button opening space rule help.",
      "localizations" : {
