            "state" : "translated",
            "value" : "%@: nelle sue impostazioni, scegli Browser, poi Aggiungi browser"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：Appの設定で「ブラウザ」を選び、「ブラウザを追加」を選択してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 해당 앱의 설정에서 브라우저를 선택한 다음 브라우저 추가를 선택하세요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: kies in de instellingen van de app Browser en daarna Browser toevoegen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: w ustawieniach aplikacji wybierz „Browser”, a następnie „Add Browser”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: nos ajustes dele, escolha Navegador e depois Adicionar navegador"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
