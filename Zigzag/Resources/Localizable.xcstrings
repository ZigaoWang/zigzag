    },
    "Click Allow to let Zigzag read %@’s bookmarks and passwords. Nothing in %@ changes." : {
      "comment" : "Message of the folder panel that lets Zigzag read a browser’s data. The placeholder is a browser’s name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf „Erlauben“, damit Zigzag die Lesezeichen und Passwörter von %1$@ lesen kann. In %2$@ ändert sich nichts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Click Allow to let Zigzag read %1$@’s bookmarks and passwords. Nothing in %2$@ changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en Permitir para que Zigzag lea los marcadores y las contraseñas de %1$@. No cambia nada en %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur Autoriser pour permettre à Zigzag de lire les signets et les mots de passe enregistrés dans %1$@. Rien n’est modifié dans %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su Consenti per permettere a Zigzag di leggere i segnalibri e le password di %@. Nulla in %@ viene modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「許可」をクリックすると、Zigzagが%1$@のブックマークとパスワードを読み取ります。%2$@の内容は何も変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag가 %1$@의 책갈피와 암호를 읽을 수 있도록 ‘허용’을 클릭하세요. %2$@의 데이터는 변경되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op Sta toe om Zigzag de bladwijzers en wachtwoorden van %1$@ te laten lezen. In %2$@ verandert niets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij „Zezwól”, aby Zigzag mógł odczytać zakładki i hasła z %1$@. W %2$@ nic się nie zmieni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em Permitir para o Zigzag ler os marcadores e as senhas de %1$@. Nada em %2$@ muda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Разрешить», чтобы Zigzag мог прочитать закладки и пароли %1$@. В %2$@ ничего не изменится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag’in %1$@ tarayıcısının yer işaretlerini ve parolalarını okumasına izin vermek için “İzin Ver”i tıklayın. %2$@ tarayıcısında hiçbir şey değişmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按“允许”，让 Zigzag 读取 %1$@ 的书签和密码。%2$@ 中的内容不会有任何改动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下「允許」，讓 Zigzag 讀取 %1$@ 的書籤和密碼。%2$@ 中的內容不會有任何改動。"
          }
        }
      }
    },
    "Click Allow to let Zigzag read Safari’s bookmarks and history. Nothing in Safari changes." : {
      "comment" : "Message of the folder panel that lets Zigzag read Safari’s data.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf „Erlauben“, damit Zigzag die Lesezeichen und den Verlauf von Safari lesen kann. In Safari ändert sich nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en Permitir para que Zigzag lea los marcadores y el historial de Safari. No cambia nada en Safari."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur Autoriser pour permettre à Zigzag de lire les signets et l’historique de Safari. Rien n’est modifié dans Safari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su Consenti per permettere a Zigzag di leggere i segnalibri e la cronologia di Safari. Nulla in Safari viene modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
