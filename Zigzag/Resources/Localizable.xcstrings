{
  "sourceLanguage" : "en",
  "strings" : {
    "Always Translate %@" : {
      "comment" : "Item in the translate menu: pages in this language are translated as they open. The name is a language's, like French.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "总是翻译%@"
          }
        }
      }
    },
    "Back, forward, reload and the address move from the sidebar to a bar above the page, and stay in view with the sidebar hidden." : {
      "comment" : "Explanation under “Address bar above the page” in Settings › Appearance.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后退、前进、重新载入和地址栏从边栏移到页面上方的一栏，隐藏边栏时也一直可见。"
          }
        }
      }
    },
    "Citron" : {
      "comment" : "Name of a curated space color, in the space editor. A pale lemon yellow.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "柠檬黄"
          }
        }
      }
    },
    "Off by default in Zigzag." : {
      "comment" : "Added to a feature flag's description in Settings › Developer, when Zigzag turns it off unlike WebKit.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 默认关闭。"
          }
        }
      }
    },
    "On by default in Zigzag." : {
      "comment" : "Added to a feature flag's description in Settings › Developer, when Zigzag turns it on unlike WebKit.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 默认打开。"
          }
        }
      }
    },
    "Reset" : {
      "comment" : "Button beside the switch of a WebKit feature flag in Settings › Developer that you changed: puts it back to its default.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还原"
          }
        }
      }
    },
    "Reset %@" : {
      "comment" : "VoiceOver name of the Reset button beside a feature flag in Settings › Developer. The placeholder is the flag's name.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还原“%@”"
          }
        }
      }
    },
    "site.user-agent" : {
      "comment" : "Row in the site panel's This Site group and in Settings › Privacy › Sites: the browser this site's pages are told they're in.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "User agent"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用户代理"
          }
        }
      }
    },
    "Custom User Agent" : {
      "comment" : "Title of the sheet from Custom… in the site panel's User agent dropdown.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定用户代理"
          }
        }
      }
    },
    "Pages on %@ are sent this in place of Zigzag’s own." : {
      "comment" : "Under the title of the Custom User Agent sheet. The placeholder is the site's name, like example.com.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向 %@ 的网页发送它，代替 Zigzag 自己的用户代理。"
          }
        }
      }
    },
    "Stone" : {
      "comment" : "Name of a curated space color, in the space editor. A clear, barely warm gray glass.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "岩灰"
          }
        }
      }
    },
    "Navy" : {
      "comment" : "Name of a curated space color, in the space editor. A deep navy blue.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "藏青"
          }
        }
      }
    },
    "Fern" : {
      "comment" : "Name of a curated space color, in the space editor. A fresh leaf green.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蕨绿"
          }
