    "A tab on %@ is using a lot of energy in the background" : {
      "comment" : "Toast when a tab in the background uses a lot of energy. The site is a domain, like example.com.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tab auf %@ verbraucht im Hintergrund viel Energie"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pestaña de %@ está usando mucha energía en segundo plano"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un onglet sur %@ utilise beaucoup d’énergie en arrière-plan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
