    "Sign-in pages and links from scripts and other apps open in a small window instead of a new tab." : {
      "comment" : "Explanation under “Open links from other apps in Zigzag Mini” in Settings › Zigzag Mini.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmeldeseiten und Links aus Skripten und anderen Apps werden in einem kleinen Fenster statt in einem neuen Tab geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las páginas de inicio de sesión y los enlaces de scripts y otras apps se abren en una ventana pequeña en lugar de una pestaña nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages de connexion et les liens provenant de scripts et d’autres apps s’ouvrent dans une petite fenêtre plutôt que dans un nouvel onglet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pagine di accesso e i link da script e altre app si aprono in una piccola finestra invece che in un nuovo pannello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログインページと、スクリプトやほかのAppからのリンクは、新規タブではなく小さなウインドウで開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 페이지와 스크립트 및 다른 앱의 링크가 새로운 탭 대신 작은 윈도우에서 열립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanmeldpagina’s en links van scripts en andere apps openen in een klein venster in plaats van een nieuw tabblad."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strony logowania i linki ze skryptów i innych aplikacji otwierają się w małym oknie zamiast w nowej karcie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As páginas de login e os links de scripts e de outros apps abrem em uma janela pequena em vez de uma nova aba."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Страницы входа и ссылки из скриптов и других приложений открываются в маленьком окне, а не в новой вкладке."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giriş sayfaları ve betiklerden ve diğer uygulamalardan gelen bağlantılar yeni sekme yerine küçük bir pencerede açılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录页、脚本和其他 App 打开的链接会在小窗口里打开，不再新开标签页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登入頁、腳本和其他 App 開啟的連結會在小視窗裡開啟，不再新開分頁。"
          }
        }
      }
    },
