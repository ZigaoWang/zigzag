    "Sites where you choose Never when Zigzag offers to save show up here, so you can change your mind." : {
      "comment" : "Shown in the Passwords window's Never Saved list when it's empty. Never is the button in the save-password prompt.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites, bei denen du „Nie“ wählst, wenn Zigzag das Sichern anbietet, erscheinen hier, damit du es dir anders überlegen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen los sitios donde eliges Nunca cuando Zigzag ofrece guardar, por si cambias de opinión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sites pour lesquels vous choisissez Jamais lorsque Zigzag propose d’enregistrer apparaissent ici, pour que vous puissiez changer d’avis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui compaiono i siti per cui scegli Mai quando Zigzag propone di salvare, così puoi cambiare idea."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzagが保存を提案したときに「しない」を選んだサイトがここに表示され、あとで考え直せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag가 저장을 제안했을 때 ‘안 함’을 선택한 사이트가 여기에 표시되므로 나중에 마음을 바꿀 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites waarvoor je Nooit kiest wanneer Zigzag aanbiedt te bewaren, verschijnen hier, zodat je van gedachten kunt veranderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witryny, dla których wybierzesz „Nigdy”, gdy Zigzag zaproponuje zachowanie, pojawią się tutaj, aby można było zmienić decyzję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os sites em que você escolhe Nunca quando o Zigzag oferece para salvar aparecem aqui, para você poder mudar de ideia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сайты, для которых вы выбрали «Никогда», когда Zigzag предлагал сохранить пароль, появятся здесь, чтобы вы могли передумать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag kaydetmeyi önerdiğinde “Hiçbir Zaman”ı seçtiğiniz siteler, fikrinizi değiştirebilmeniz için burada görünür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 Zigzag 提示存储密码时，你选择“永不”的网站会显示在这里，方便你改变主意。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當 Zigzag 提示儲存密碼時，你選取「永不」的網站會顯示在這裡，方便你改變主意。"
          }
        }
      }
    },
    "Sites you turn Developer Mode on for show up here." : {
      "comment" : "Explanation under “None yet” in Settings › Developer.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites, für die du den Entwicklermodus einschaltest, erscheinen hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen los sitios para los que activas el modo de desarrollo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sites pour lesquels vous activez le mode développeur apparaissent ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui compaiono i siti per cui attivi la modalità sviluppatore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デベロッパモードをオンにしたサイトがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개발자 모드를 켠 사이트가 여기에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites waarvoor je de ontwikkelaarsmodus inschakelt, verschijnen hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witryny, dla których włączysz tryb programisty, pojawią się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os sites para os quais você ativa o Modo de desenvolvedor aparecem aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появятся сайты, для которых вы включите режим разработчика."
          }
        },
        "tr" : {
          "stringUnit" : {
