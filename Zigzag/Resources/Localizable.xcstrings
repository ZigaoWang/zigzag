    "An update is ready. Until you allow it, the current version keeps running." : {
      "comment" : "Under the title of the sheet shown when an extension's update asks for more access, when the update has no version.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Update ist bereit. Bis du es erlaubst, läuft die aktuelle Version weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una actualización lista. Hasta que la permitas, sigue funcionando la versión actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une mise à jour est prête. Tant que vous ne l’autorisez pas, la version actuelle reste active."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un aggiornamento è pronto. Finché non lo consenti, continua a funzionare la versione attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートの準備ができました。許可するまでは、現在のバージョンが実行されたままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트가 준비되었습니다. 허용하기 전까지는 현재 버전이 계속 실행됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er staat een update klaar. Tot je die toestaat, blijft de huidige versie draaien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizacja jest gotowa. Dopóki jej nie zatwierdzisz, nadal działa bieżąca wersja."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
