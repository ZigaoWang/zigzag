    "Your passwords are locked. Unlock with Touch ID or your Mac’s password." : {
      "comment" : "Shown in the locked Passwords window.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Passwörter sind gesperrt. Entsperre sie mit Touch ID oder dem Passwort deines Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus contraseñas están bloqueadas. Desbloquéalas con Touch ID o con la contraseña de tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos mots de passe sont verrouillés. Déverrouillez-les avec Touch ID ou le mot de passe de votre Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue password sono bloccate. Sblocca con Touch ID o con la password del Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードはロックされています。Touch IDまたはMacのパスワードでロックを解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호가 잠겨 있습니다. Touch ID 또는 Mac 암호로 잠금 해제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wachtwoorden zijn vergrendeld. Ontgrendel met Touch ID of het wachtwoord van je Mac."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasła są zablokowane. Odblokuj za pomocą Touch ID lub hasła do Maca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas senhas estão bloqueadas. Desbloqueie com o Touch ID ou a senha do seu Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши пароли заблокированы. Разблокируйте их с помощью Touch ID или пароля вашего Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parolalarınız kilitli. Touch ID veya Mac’inizin parolasıyla kilidi açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的密码已锁定。请使用触控 ID 或你的 Mac 密码解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的密碼已鎖定。請使用觸控 ID 或你的 Mac 密碼解鎖。"
          }
        }
      }
    },
    "Your passwords are saved in Zigzag, in your Mac’s Keychain, and sync with iCloud Keychain. Find them in Zigzag › Passwords." : {
      "comment" : "Import window when the import is done. Zigzag › Passwords is the menu item's path; Keychain and iCloud Keychain are Apple's names.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Passwörter sind in Zigzag im Schlüsselbund deines Mac gesichert und werden mit dem iCloud-Schlüsselbund synchronisiert. Du findest sie unter „Zigzag“ › „Passwörter“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus contraseñas se guardan en Zigzag, en el llavero de tu Mac, y se sincronizan con el llavero de iCloud. Búscalas en Zigzag › Contraseñas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos mots de passe sont enregistrés dans Zigzag, dans le trousseau de votre Mac, et se synchronisent avec le trousseau iCloud. Retrouvez-les dans Zigzag › Mots de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue password sono salvate in Zigzag, nel Portachiavi del Mac, e si sincronizzano con il Portachiavi di iCloud. Le trovi in Zigzag › Password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードはZigzagでMacのキーチェーンに保存され、iCloudキーチェーンで同期されます。「Zigzag › パスワード」で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호는 Zigzag에서 Mac의 키체인에 저장되며 iCloud 키체인과 동기화됩니다. Zigzag › 암호에서 확인할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wachtwoorden zijn bewaard in Zigzag, in de sleutelhanger van je Mac, en worden gesynchroniseerd met de iCloud-sleutelhanger. Je vindt ze in Zigzag › Wachtwoorden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasła są zachowane w Zigzag, w pęku kluczy Maca, i synchronizowane z pękiem kluczy iCloud. Znajdziesz je w „Zigzag” › „Hasła”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas senhas estão salvas no Zigzag, nas Chaves do seu Mac, e sincronizam com as Chaves do iCloud. Encontre-as em Zigzag › Senhas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши пароли сохранены в Zigzag, в связке ключей вашего Mac, и синхронизируются через Связку ключей iCloud. Они находятся в меню «Zigzag» › «Пароли»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parolalarınız Zigzag’de, Mac’inizin Anahtar Zinciri’nde saklanır ve iCloud Anahtar Zinciri ile eşzamanlanır. Bunları Zigzag › Parolalar’da bulabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的密码存储在 Zigzag 中，保存在你 Mac 的钥匙串里，并通过 iCloud 钥匙串同步。可以在“Zigzag › 密码”中找到它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的密碼儲存在 Zigzag 中，儲存在你 Mac 的鑰匙圈裡，並透過 iCloud 鑰匙圈同步。可以在「Zigzag › 密碼」中找到它們。"
          }
        }
      }
    },
    "Your phone needs to be on the same network as this Mac, and your development server needs to listen on it too, not only on localhost (for most, a host of 0.0.0.0)." : {
      "comment" : "Under the address in the Open on Your Phone sheet of the developer tools. 0.0.0.0 is a server setting, kept as is.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Smartphone muss im selben Netzwerk wie dieser Mac sein, und dein Entwicklungsserver muss auch dort lauschen, nicht nur auf localhost (meist mit dem Host 0.0.0.0)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu teléfono debe estar en la misma red que este Mac, y tu servidor de desarrollo también debe escuchar en ella, no solo en localhost (en la mayoría, un host de 0.0.0.0)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre téléphone doit être sur le même réseau que ce Mac, et votre serveur de développement doit aussi écouter sur ce réseau, pas seulement sur localhost (le plus souvent, avec l’hôte 0.0.0.0)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il telefono deve essere sulla stessa rete di questo Mac, e anche il tuo server di sviluppo deve essere in ascolto su di essa, non solo su localhost (per la maggior parte, con host 0.0.0.0)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneなどをこのMacと同じネットワークにつなぎ、開発サーバもlocalhostだけでなくそのネットワークで待ち受ける必要があります（多くの場合、ホストを0.0.0.0にします）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰이 이 Mac과 같은 네트워크에 연결되어 있어야 하며, 개발 서버도 localhost뿐 아니라 해당 네트워크에서 수신 대기해야 합니다(대부분 호스트를 0.0.0.0으로 설정)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je telefoon moet op hetzelfde netwerk zitten als deze Mac en je ontwikkelserver moet daar ook op luisteren, niet alleen op localhost (voor de meeste is dat een host van 0.0.0.0)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon musi być w tej samej sieci co ten Mac, a serwer deweloperski musi nasłuchiwać także w niej, nie tylko na localhost (zwykle host 0.0.0.0)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O celular precisa estar na mesma rede que este Mac, e o servidor de desenvolvimento também precisa escutar nela, não só em localhost (para a maioria, um host 0.0.0.0)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телефон должен быть в той же сети, что и этот Mac, а ваш сервер разработки должен слушать и в ней, а не только на localhost (для большинства это хост 0.0.0.0)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonunuz bu Mac ile aynı ağda olmalı ve geliştirme sunucunuz yalnızca localhost’ta değil, o ağda da dinlemeli (çoğu için ana makine 0.0.0.0)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手机需要和这台 Mac 连接同一个网络，你的开发服务器也需要在这个网络上监听，而不只是 localhost（多数情况下把主机设为 0.0.0.0）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手機需要和這台 Mac 連線同一個網路，你的開發伺服器也需要在這個網路上監聽，而不只是 localhost（多數情況下把主機設為 0.0.0.0）。"
          }
        }
      }
    },
    "Your sign-ins from %@ couldn’t come over, so sites will ask you to sign in again." : {
      "comment" : "Problem in the Import window. The placeholder is a browser's name, like Chrome. Sign-ins are the sites a browser keeps you signed in to.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Anmeldungen aus %@ konnten nicht übernommen werden, daher fragen Websites erneut nach deiner Anmeldung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron traer tus inicios de sesión de %@, así que los sitios te pedirán iniciar sesión de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos connexions depuis %@ n’ont pas pu être importées : les sites vous demanderont de vous connecter à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli accessi da %@ non sono stati importati, quindi i siti ti chiederanno di accedere di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のログイン状態を移行できなかったため、サイトで再度ログインを求められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 로그인 상태를 가져오지 못해 사이트에서 다시 로그인하라는 메시지가 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je aanmeldingen van %@ konden niet worden overgenomen, dus websites vragen je opnieuw aan te melden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logowania z %@ nie mogły zostać przeniesione, więc witryny poproszą o ponowne zalogowanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus logins de %@ não puderam ser importados, então os sites vão pedir que você faça login novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Входы из %@ не удалось перенести, поэтому сайты попросят вас войти снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tarayıcısındaki girişleriniz aktarılamadı, bu yüzden siteler yeniden giriş yapmanızı isteyecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 中的登录状态未能导入，所以网站会要求你重新登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 中的登入狀態無法匯入，所以網站會要求你重新登入。"
          }
        }
      }
    },
    "Your spaces, tabs, favorites and history go back to how they were before the last update, and Zigzag restarts. Logins and passwords aren’t affected." : {
      "comment" : "Message of the sheet that restores the backup.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Spaces, Tabs, Favoriten und dein Verlauf werden auf den Stand vor dem letzten Update zurückgesetzt, und Zigzag startet neu. Anmeldungen und Passwörter sind nicht betroffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus espacios, pestañas, favoritos e historial vuelven a como estaban antes de la última actualización, y Zigzag se reinicia. Los inicios de sesión y las contraseñas no se ven afectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos espaces, onglets, favoris et historique reviennent à leur état d’avant la dernière mise à jour, et Zigzag redémarre. Les identifiants et les mots de passe ne sont pas concernés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazi, pannelli, preferiti e cronologia tornano com’erano prima dell’ultimo aggiornamento e Zigzag si riavvia. Accessi e password non sono interessati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スペース、タブ、お気に入り、履歴が前回のアップデート前の状態に戻り、Zigzagが再起動します。ログイン情報とパスワードには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스페이스, 탭, 즐겨찾기 및 방문 기록이 마지막 업데이트 이전 상태로 돌아가고 Zigzag가 재시동됩니다. 로그인 정보와 암호에는 영향이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je spaces, tabbladen, favorieten en geschiedenis gaan terug naar hoe ze vóór de laatste update waren en Zigzag herstart. Aanmeldingen en wachtwoorden worden niet beïnvloed."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje przestrzenie, karty, ulubione i historia wrócą do stanu sprzed ostatniej aktualizacji, a Zigzag uruchomi się ponownie. Logowania i hasła nie zostaną zmienione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus espaços, abas, favoritos e histórico voltam a como estavam antes da última atualização, e o Zigzag reinicia. Logins e senhas não são afetados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши пространства, вкладки, избранное и история вернутся к состоянию до последнего обновления, и Zigzag перезапустится. Входы и пароли это не затронет."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space’leriniz, sekmeleriniz, favorileriniz ve geçmişiniz son güncellemeden önceki hâline döner ve Zigzag yeniden başlar. Girişler ve parolalar etkilenmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的空间、标签页、收藏和历史记录会恢复到上次更新之前的样子，然后 Zigzag 会重新启动。登录信息和密码不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的空間、分頁、收藏和瀏覽記錄會恢復到上次更新之前的樣子，然後 Zigzag 會重新啟動。登入資訊和密碼不受影響。"
          }
        }
      }
    },
    "Your tabs and spaces are saved, and History › Reopen Last Session brings them back." : {
      "comment" : "Message of the sheet that asks before quitting, with On launch set to Start Fresh: the next launch opens a new window, and the session is reopened from the History menu.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Tabs und Spaces werden gesichert, und „Verlauf“ › „Letzte Sitzung wieder öffnen“ holt sie zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus pestañas y espacios se guardan, y Historial › Reabrir última sesión los recupera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos onglets et vos espaces sont enregistrés, et Historique › Rouvrir la dernière session les rouvre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pannelli e spazi sono salvati e Cronologia › Riapri l’ultima sessione li riporta indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブとスペースは保存されています。「履歴 › 前回のセッションを再度開く」で元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭과 스페이스가 저장되며, 방문 기록 › 마지막 세션 다시 열기로 다시 불러올 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je tabbladen en spaces zijn bewaard en met Geschiedenis › Open laatste sessie opnieuw haal je ze terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karty i przestrzenie zostały zachowane, a „Historia” › „Otwórz ponownie ostatnią sesję” je przywraca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas abas e espaços estão salvos, e Histórico › Reabrir última sessão os traz de volta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши вкладки и пространства сохранены, а команда «История» › «Открыть последний сеанс снова» вернёт их."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekmeleriniz ve Space’leriniz kaydedilir; Geçmiş › Son Oturumu Yeniden Aç bunları geri getirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的标签页和空间都已保存，“历史记录 › 重新打开上次会话”可以再把它们带回来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的分頁和空間都已儲存，「瀏覽記錄 › 重新開啟上次工作階段」可以再把它們帶回來。"
          }
        }
      }
    },
    "Your tabs and spaces will be right here when you open it again." : {
      "comment" : "Message of the sheet that asks before quitting; “it” is Zigzag.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Tabs und Spaces sind genau hier, wenn du Zigzag wieder öffnest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus pestañas y espacios estarán aquí cuando lo vuelvas a abrir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos onglets et vos espaces vous attendront ici à la prochaine ouverture."
          }
        },
        "it" : {
          "stringUnit" : {
