    "It can read and change pages on this site and its subdomains." : {
      "comment" : "Under the title of the sheet that adds a site an extension may use, from Settings › Extensions.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erweiterung kann Seiten auf dieser Website und ihren Subdomains lesen und ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede leer y cambiar páginas de este sitio y sus subdominios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle peut lire et modifier les pages de ce site et de ses sous-domaines."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Può leggere e modificare le pagine di questo sito e dei suoi sottodomini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサイトとそのサブドメインのページを読み取り、変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사이트 및 하위 도메인의 페이지를 읽고 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De extensie kan pagina’s op deze website en de subdomeinen ervan lezen en wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może odczytywać i zmieniać strony w tej witrynie i jej subdomenach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela pode ler e alterar as páginas deste site e dos subdomínios dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оно может читать и изменять страницы этого сайта и его поддоменов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sitedeki ve alt alan adlarındaki sayfaları okuyabilir ve değiştirebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
