          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавить локальный сервер"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel Sunucu Ekle"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加本地服务器"
          }
