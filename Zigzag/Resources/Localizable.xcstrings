        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 암호와 로그인 상태가 잠겨 있습니다. ‘다시 시도’를 클릭하고 macOS에서 요청하면 Mac 암호를 입력한 다음 ‘허용’을 클릭하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
