    "Zigzag on GitHub" : {
      "comment" : "Help menu item.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 上的 Zigzag"
          }
        }
      }
    },
    "Zigzag updated to %@" : {
      "comment" : "Toast after an update, with the new version number, like 0.5.2.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 已更新到 %@"
          }
        }
      }
    },
    "Zigzag won’t offer to save passwords on this site. Allow it, and the next time you sign in there you’ll be asked again." : {
      "comment" : "Shown for a Never Saved site in the Passwords window.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 不会在此网站上提示存储密码。允许后，下次你在那里登录时会再次询问。"
          }
        }
      }
    },
    "Zigzag won’t open this port" : {
      "comment" : "Title of the page Zigzag shows when a page can't load.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 不会打开此端口"
          }
        }
      }
    },
    "Zigzag writes a short report for your email: its version, your Mac, what went wrong lately and on which sites, and crash and freeze reports. Never the pages’ addresses, your tabs or history. Show Report lets you read it first." : {
      "comment" : "Message of the Report a Problem sheet. “Show Report” is the sheet's other button.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 会为你的电子邮件写一份简短的报告：它的版本、你的 Mac、最近出了什么问题以及在哪些网站上，还有崩溃和卡顿报告。绝不包含页面地址、你的标签页或历史记录。点按“显示报告”可以先读一读。"
          }
        }
      }
    },
