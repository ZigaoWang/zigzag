    "Couldn’t save a backup first, so sync is still off." : {
      "comment" : "Status under Sync with iCloud in Settings › General, when turning it on couldn't save the backup it makes first (the disk is full, say).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnte vorher kein Backup gesichert werden, deshalb ist die Synchronisierung weiterhin aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar antes una copia de seguridad, así que la sincronización sigue desactivada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer d’abord une sauvegarde : la synchronisation reste désactivée."
          }
        },
        "it" : {
          "stringUnit" : {
