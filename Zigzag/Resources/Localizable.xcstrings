    "%@ was made by a newer Zigzag. Update Zigzag, then import it again." : {
      "comment" : "Problem in the Import window, for a Zigzag backup. The placeholder is the file's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde mit einer neueren Version von Zigzag erstellt. Aktualisiere Zigzag und importiere die Datei dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se creó con una versión más reciente de Zigzag. Actualiza Zigzag y vuelve a importarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier %@ a été créé par une version plus récente de Zigzag. Mettez à jour Zigzag, puis importez-le à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stato creato da una versione più recente di Zigzag. Aggiorna Zigzag, poi importalo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は新しいバージョンのZigzagで作成されています。Zigzagをアップデートしてから、もう一度読み込んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 최신 버전의 Zigzag에서 만들어졌습니다. Zigzag를 업데이트한 다음 다시 가져오세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is gemaakt met een nieuwere versie van Zigzag. Werk Zigzag bij en importeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik %@ został utworzony w nowszej wersji Zigzag. Zaktualizuj Zigzag i zaimportuj go ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ foi criado por uma versão mais recente do Zigzag. Atualize o Zigzag e importe novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ создан в более новой версии Zigzag. Обновите Zigzag и импортируйте файл снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, daha yeni bir Zigzag sürümüyle oluşturulmuş. Zigzag’i güncelleyin, sonra yeniden içe aktarın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是由更新版本的 Zigzag 制作的。请更新 Zigzag，然后再导入一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是由較新版本的 Zigzag 製作的。請更新 Zigzag，然後再匯入一次。"
          }
        }
      }
    },
    "%@ isn’t a Zigzag backup Zigzag can read." : {
      "comment" : "Problem in the Import window, for a Zigzag backup. The placeholder is the file's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist kein Zigzag-Backup, das Zigzag lesen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no es una copia de seguridad de Zigzag que Zigzag pueda leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas une sauvegarde Zigzag lisible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è un backup di Zigzag leggibile da Zigzag."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はZigzagで読み込めるZigzagバックアップではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) Zigzag가 읽을 수 있는 Zigzag 백업이 아닙니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is geen Zigzag-reservekopie die Zigzag kan lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik %@ nie jest kopią zapasową Zigzag, którą Zigzag potrafi odczytać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não é um backup do Zigzag que o Zigzag consiga ler."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag не удаётся прочитать %@ как резервную копию Zigzag."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, Zigzag’in okuyabileceği bir Zigzag yedeği değil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Zigzag 能读取的 Zigzag 备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Zigzag 能讀取的 Zigzag 備份。"
          }
        }
      }
    },
    "Your settings came over too. Some take effect the next time Zigzag opens." : {
      "comment" : "Note in the Import window after a Zigzag backup's settings were restored.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Einstellungen wurden ebenfalls übernommen. Manche werden erst beim nächsten Öffnen von Zigzag wirksam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se han traído tus ajustes. Algunos se aplican la próxima vez que abras Zigzag."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos réglages ont aussi été importés. Certains prendront effet à la prochaine ouverture de Zigzag."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono state importate anche le tue impostazioni. Alcune hanno effetto alla prossima apertura di Zigzag."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定も移行されました。一部はZigzagを次に開いたときに反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정도 함께 가져왔습니다. 일부 설정은 다음에 Zigzag를 열 때 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je instellingen zijn ook overgenomen. Sommige gelden pas de volgende keer dat Zigzag opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia również zostały przeniesione. Niektóre zaczną obowiązywać po następnym otwarciu Zigzag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus ajustes também foram trazidos. Alguns só valem na próxima vez que o Zigzag abrir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки тоже перенесены. Некоторые вступят в силу при следующем запуске Zigzag."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlarınız da geldi. Bazıları Zigzag’in bir sonraki açılışında etkili olur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的设置也一并带过来了。部分设置要在下次打开 Zigzag 时生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的設定也一併帶過來了。部分設定要在下次開啟 Zigzag 時生效。"
          }
        }
      }
    },
