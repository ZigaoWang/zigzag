    "Its keyword no longer searches it from the address bar." : {
      "comment" : "Message of the sheet that deletes a site from Site Search in Settings › Search.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Schlüsselwort durchsucht die Website dann nicht mehr aus der Adressleiste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su palabra clave dejará de buscar en él desde la barra de direcciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son mot-clé ne lancera plus de recherche sur ce site depuis la barre d’adresse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua parola chiave non cercherà più nel sito dalla barra degli indirizzi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーワードを入力しても、アドレスバーからこのサイト内を検索しなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키워드로 더 이상 주소 막대에서 이 사이트를 검색하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het trefwoord zoekt dan niet meer op de website vanuit de adresbalk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słowo kluczowe nie będzie już przeszukiwać tej witryny z paska adresu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A palavra-chave deixará de buscar no site pela barra de endereço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключевое слово больше не будет искать на этом сайте из адресной строки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
