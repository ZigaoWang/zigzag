    "It sends Zigzag around in a loop. Clearing this site’s cookies often fixes it." : {
      "comment" : "Message on the page Zigzag shows when a page can't load.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Website leitet Zigzag endlos weiter. Das Löschen ihrer Cookies hilft oft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace que Zigzag entre en un bucle de redirecciones. Borrar las cookies de este sitio suele solucionarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il fait tourner Zigzag en boucle. Effacer les cookies de ce site résout souvent le problème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manda Zigzag in un ciclo. Cancellare i cookie di questo sito spesso risolve il problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzagがリダイレクトのループに陥っています。このサイトのCookieを消去すると解決することがよくあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사이트가 Zigzag를 계속 리디렉션하고 있습니다. 이 사이트의 쿠키를 지우면 해결되는 경우가 많습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het stuurt Zigzag in een kringetje rond. Het wissen van de cookies van deze website lost dit vaak op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapętla Zigzag. Wyczyszczenie plików cookie tej witryny często to naprawia."
