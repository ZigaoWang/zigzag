    "Or click + in the sidebar, then choose New Space" : {
      "comment" : "Under the new space step's title in the getting-started guide, a card in the window, after the keys that make a space. New Space is an item in the menu of the sidebar's +.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder klicke in der Seitenleiste auf + und wähle dann „Neuer Space“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O haz clic en + en la barra lateral y elige Nuevo espacio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou cliquez sur + dans la barre latérale, puis choisissez Nouvel espace"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure fai clic su + nella barra laterale, poi scegli Nuovo spazio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "またはサイドバーの＋をクリックして、「新規スペース」を選択"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "또는 사이드바에서 +를 클릭한 다음 ‘새로운 스페이스’를 선택하세요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of klik op + in de navigatiekolom en kies Nieuwe space"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lub kliknij + na pasku bocznym, a następnie wybierz „Nowa przestrzeń”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou clique em + na barra lateral e escolha Novo espaço"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или нажмите + в боковом меню и выберите «Новое пространство»"
          }
        },
        "tr" : {
          "stringUnit" : {
