    "Firefox Add-ons didn’t answer, so this extension couldn’t be checked and wasn’t added. Try again in a moment." : {
      "comment" : "Shown when Add to Firefox on addons.mozilla.org was clicked but the store's API couldn't be reached to check the file.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firefox-Add-ons hat nicht geantwortet, daher konnte diese Erweiterung nicht geprüft werden und wurde nicht hinzugefügt. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complementos de Firefox no respondió, así que no se pudo comprobar esta extensión y no se añadió. Vuelve a intentarlo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modules complémentaires Firefox n’a pas répondu : cette extension n’a donc pas pu être vérifiée ni ajoutée. Réessayez dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sito dei Componenti aggiuntivi di Firefox non ha risposto, quindi non è stato possibile controllare questa estensione e non è stata aggiunta. Riprova tra poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firefoxアドオンから応答がなかったため、この機能拡張を確認できず、追加しませんでした。少し待ってからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firefox 부가 기능에서 응답이 없어 이 확장 프로그램을 확인하지 못했으며 추가하지 않았습니다. 잠시 후에 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firefox-add-ons reageerde niet, dus deze extensie kon niet worden gecontroleerd en is niet toegevoegd. Probeer het zo opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firefox Add-ons nie odpowiada, więc nie można było sprawdzić tego rozszerzenia i nie zostało ono dodane. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Extras do Firefox não responderam, então esta extensão não pôde ser verificada e não foi adicionada. Tente novamente em instantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firefox Add-ons не ответил, поэтому расширение не удалось проверить, и оно не было добавлено. Повторите попытку через минуту."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firefox Add-ons yanıt vermedi, bu yüzden bu genişletme denetlenemedi ve eklenmedi. Biraz sonra yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firefox 附加组件没有回应，无法检查这个扩展，所以没有添加。请稍后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firefox 附加元件沒有回應，無法檢查這個延伸功能，所以沒有新增。請稍後再試。"
          }
        }
      }
    },
    "Find one in the Chrome Web Store or Firefox Add-ons and choose Add to Zigzag." : {
      "comment" : "Explanation under “No extensions yet” in Settings › Extensions. Firefox Add-ons is addons.mozilla.org.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche im Chrome Web Store oder bei Firefox-Add-ons nach einer und wähle „Zu Zigzag hinzufügen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca una en Chrome Web Store o en Complementos de Firefox y elige Añadir a Zigzag."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouvez-en une dans le Chrome Web Store ou sur Modules complémentaires Firefox, et choisissez Ajouter à Zigzag."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cercane una nel Chrome Web Store o nei Componenti aggiuntivi di Firefox e scegli Aggiungi a Zigzag."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChromeウェブストアまたはFirefoxアドオンで機能拡張を見つけて、「Zigzagに追加」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chrome 웹 스토어나 Firefox 부가 기능에서 확장 프로그램을 찾은 다음 ‘Zigzag에 추가’를 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek er een in de Chrome Web Store of Firefox-add-ons en kies Voeg toe aan Zigzag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znajdź je w Chrome Web Store lub Firefox Add-ons i wybierz „Dodaj do Zigzag”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontre uma na Chrome Web Store ou nos Extras do Firefox e escolha Adicionar ao Zigzag."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдите его в Chrome Web Store или Firefox Add-ons и выберите «Добавить в Zigzag»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chrome Web Store’da veya Firefox Add-ons’ta bir tane bulun ve “Zigzag’e Ekle” düğmesini seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Chrome 网上应用店或 Firefox 附加组件中找一个扩展，然后选择“添加到 Zigzag”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Chrome 線上應用程式商店或 Firefox 附加元件中找一個延伸功能，然後選取「新增到 Zigzag」。"
          }
        }
      }
    },
    "The video floats over other apps and desktops, and goes back in its page when you return." : {
      "comment" : "Explanation under “Show a mini player when you leave Zigzag” in Settings › Tabs.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Video schwebt über anderen Apps und Schreibtischen und kehrt in seine Seite zurück, wenn du zurückkommst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vídeo flota sobre otras apps y escritorios, y vuelve a su página cuando regresas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vidéo flotte au-dessus des autres apps et des bureaux, et retourne dans sa page lorsque vous revenez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il video resta sopra le altre app e scrivanie, e rientra nella pagina quando torni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオがほかのAppやデスクトップの上に浮かび、戻るとページの中に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오가 다른 앱과 데스크탑 위에 떠 있으며, 돌아오면 원래 페이지로 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De video zweeft boven andere apps en bureaubladen en gaat terug naar de pagina wanneer je terugkeert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wideo unosi się nad innymi aplikacjami i pulpitami, a po powrocie wraca na swoją stronę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O vídeo flutua sobre outros apps e mesas e volta para a página quando você retorna."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видео остаётся поверх других приложений и рабочих столов и возвращается на свою страницу, когда вы возвращаетесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video diğer uygulamaların ve masaüstlerinin üzerinde yüzer, siz geri döndüğünüzde sayfasına geri girer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频会在其他 App 和桌面上方浮动，回到 Zigzag 时再回到页面里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影片會在其他 App 和桌面上方浮動，回到 Zigzag 時再回到網頁裡。"
          }
        }
      }
    },
