          }
        }
      }
    },
    "Find one in the Chrome Web Store or Firefox Add-ons and choose Add to Zigzag." : {
      "comment" : "Explanation under “No extensions yet” in Settings › Extensions. Firefox Add-ons is addons.mozilla.org.",
      "localizations" : {
        "zh-Hans" : {
