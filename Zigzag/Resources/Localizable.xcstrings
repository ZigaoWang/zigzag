    "Only %@’s history is cleared; other profiles keep theirs." : {
      "comment" : "Added to the message of a sheet that asks before clearing History, when there's more than one profile. The placeholder is the profile's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der Verlauf von „%@“ wird gelöscht. Andere Profile behalten ihren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se borra el historial de %@; los demás perfiles conservan el suyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul l’historique du profil %@ est effacé ; les autres profils conservent le leur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene cancellata solo la cronologia di %@; gli altri profili conservano la propria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の履歴だけが消去されます。ほかのプロファイルの履歴はそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 방문 기록만 지워지며, 다른 프로필의 방문 기록은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen de geschiedenis van %@ wordt gewist; andere profielen behouden de hunne."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko historia profilu „%@” zostanie wyczyszczona; inne profile zachowują swoją."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só o histórico do perfil %@ é limpo; os outros perfis mantêm o deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очищается только история профиля «%@»; в других профилях она сохраняется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca “%@” profilinin geçmişi temizlenir; diğer profiller kendilerininkini korur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会清除“%@”的历史记录，其他个人资料的不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會清除「%@」的瀏覽記錄，其他個人資料的不受影響。"
          }
        }
      }
    },
    "Only in %@; other profiles aren’t changed." : {
      "comment" : "Added to the message of a sheet that asks before clearing the cache or cookies, when there's more than one profile. The placeholder is the profile's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur in „%@“. Andere Profile werden nicht geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo en %@; los demás perfiles no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement dans %@ ; les autres profils ne sont pas modifiés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo in %@; gli altri profili non vengono modificati."
          }
        },
        "ja" : {
