          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag не удалось прочитать ваши профили, поэтому все пространства пока в профиле «Основной». Файл сохранён."
          }
        },
        "tr" : {
