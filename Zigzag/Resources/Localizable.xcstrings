    "Search %@" : {
      "comment" : "In the command bar, when what's typed names a site: Tab searches it. The name is the site's, like YouTube.\nPlaceholder of the command bar's field while it searches one site. The name is the site's, like YouTube.\nUnder each result while the command bar searches one site. The name is the site's, like YouTube.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
