            "value" : "Sincronizar com o iCloud?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизировать с iCloud?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ile eşzamanlansın mı?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
