    "Choose a password export (a .csv file), a bookmarks export (an .html file) or Safari’s exported browsing data (a .zip file)." : {
      "comment" : "Message of the open panel from the welcome window’s Import a password file… link.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Passwortexport (.csv-Datei), einen Lesezeichenexport (.html-Datei) oder exportierte Safari-Browserdaten (.zip-Datei)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una exportación de contraseñas (un archivo .csv), una exportación de marcadores (un archivo .html) o los datos de navegación exportados de Safari (un archivo .zip)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une exportation de mots de passe (fichier .csv), une exportation de signets (fichier .html) ou les données de navigation exportées de Safari (fichier .zip)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un’esportazione di password (file .csv), un’esportazione di segnalibri (file .html) o i dati di navigazione esportati da Safari (file .zip)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードの書き出しファイル（.csvファイル）、ブックマークの書き出しファイル（.htmlファイル）、またはSafariから書き出したブラウズデータ（.zipファイル）を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호 내보내기 파일(.csv), 책갈피 내보내기 파일(.html) 또는 Safari에서 내보낸 브라우징 데이터(.zip)를 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een wachtwoordexport (een .csv-bestand), een bladwijzerexport (een .html-bestand) of de geëxporteerde browsegegevens van Safari (een .zip-bestand)."
          }
        },
        "pl" : {
