        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag가 사이트의 인증서를 읽을 수 없으므로 무시하고 신뢰할 수도 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag kon het certificaat van de website niet lezen, dus het kan hoe dan ook niet worden vertrouwd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag nie mógł odczytać certyfikatu witryny, więc nie można jej odwiedzić mimo ostrzeżenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
