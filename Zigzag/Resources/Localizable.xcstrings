    },
    "It may be busy or down right now. Try again in a moment." : {
      "comment" : "Message on the page Zigzag shows when a page can't load.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Website ist vielleicht gerade ausgelastet oder nicht erreichbar. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que esté ocupado o caído ahora mismo. Inténtalo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est peut-être occupé ou indisponible pour le moment. Réessayez dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrebbe essere occupato o non disponibile in questo momento. Riprova tra poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
