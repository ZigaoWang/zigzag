    "GitHub asked Zigzag to wait. It tries again later." : {
      "comment" : "Why a live folder of GitHub pull requests or issues couldn't refresh, in its menu in the sidebar: too many requests.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub hat Zigzag gebeten zu warten. Zigzag versucht es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub pidió a Zigzag que esperara. Lo intentará más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub a demandé à Zigzag de patienter. Il réessaiera plus tard."
          }
        },
        "it" : {
