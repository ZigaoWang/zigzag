    "%@ is on %@, a profile with its own sign-ins and extensions. The page reloads there and keeps its back and forward history." : {
      "comment" : "Message of the sheet that asks before a tab moves to a space on another profile. First the space's name, then the profile's.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ gehört zu „%2$@“. Die Seite wird dort mit den Anmeldungen und Erweiterungen dieses Profils neu geladen und behält ihren Verlauf für Zurück und Vorwärts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is on %2$@. The page reloads there, with that profile’s sign-ins and extensions, and keeps its back and forward history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está en %2$@. La página se recarga allí, con los inicios de sesión y las extensiones de ese perfil, y conserva su historial de atrás y adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ fait partie du profil %2$@. La page y est rechargée, avec les connexions et les extensions de ce profil, et conserve son historique de navigation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ si trova nel profilo %2$@. La pagina viene ricaricata lì, con gli accessi e le estensioni di quel profilo, e mantiene la cronologia avanti e indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は%2$@にあります。ページはそこで再読み込みされ、そのプロファイルのログイン状態と機能拡張が使われます。戻る・進むの履歴はそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) %2$@에 있습니다. 페이지가 해당 프로필의 로그인 상태와 확장 프로그램으로 다시 로드되며, 뒤로 및 앞으로 방문 기록은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ staat op %2$@. De pagina wordt daar opnieuw geladen, met de aanmeldingen en extensies van dat profiel, en behoudt zijn geschiedenis voor terug en vooruit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przestrzeń „%1$@” jest w profilu „%2$@”. Strona zostanie tam wczytana ponownie z logowaniami i rozszerzeniami tego profilu i zachowa historię przejść wstecz i dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está no perfil %2$@. A página recarrega lá, com os logins e as extensões desse perfil, e mantém o histórico de voltar e avançar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пространство «%1$@» находится в профиле «%2$@». Страница перезагрузится там, с входами и расширениями этого профиля, и сохранит историю переходов назад и вперёд."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” Space’i, “%2$@” profilinde. Sayfa orada, o profilin girişleri ve genişletmeleriyle yeniden yüklenir; geri ve ileri geçmişi korunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”位于个人资料“%2$@”，它有自己的登录状态和扩展。页面会在那里重新载入，并保留前进和后退记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」位於個人資料「%2$@」，它有自己的登入狀態和延伸功能。網頁會在那裡重新載入，並保留前進和後退記錄。"
          }
        }
      }
    },
