        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не может прослушивать эту вкладку. Её звук защищён или недоступен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bu sekmeyi dinleyemiyor. Sesi korumalı veya erişilemiyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法收听这个标签页：它的声音受保护或无法获取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 無法擷取此分頁的音訊，因為音訊受到保護或無法存取。"
          }
        }
      }
    },
    "%@ can’t listen to this tab while %@ is. Turn %@ off for this tab, then try again." : {
      "comment" : "Toast when an extension asks to hear a tab another extension is already listening to; only one can at a time, as in Chrome. The first placeholder is the extension that asked, the other two the one listening, like Sound Booster.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kann bei diesem Tab nicht mithören, solange %2$@ zuhört. Schalte %3$@ für diesen Tab aus und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ can’t listen to this tab while %2$@ is. Turn %3$@ off for this tab, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no puede escuchar esta pestaña mientras %2$@ la escucha. Desactiva %3$@ en esta pestaña y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne peut pas écouter cet onglet : %2$@ l’écoute déjà. Désactivez %3$@ pour cet onglet, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non può ascoltare questo pannello mentre lo fa %@. Disattiva %@ per questo pannello, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@がこのタブを聞いているあいだは、%1$@は聞くことができません。このタブで%3$@をオフにしてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@이(가) 이 탭을 듣는 동안에는 %1$@에서 들을 수 없습니다. 이 탭에서 %3$@을(를) 끈 다음 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kan niet naar dit tabblad luisteren zolang %2$@ dat doet. Zet %3$@ uit voor dit tabblad en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ nie może słuchać tej karty, gdy słucha jej %2$@. Wyłącz %3$@ dla tej karty i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ não consegue ouvir esta aba enquanto %2$@ está ouvindo. Desative %3$@ nesta aba e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ не может прослушивать эту вкладку, пока её прослушивает %2$@. Выключите %3$@ для этой вкладки и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bu sekmeyi dinleyemiyor çünkü %2$@ dinliyor. Bu sekme için %3$@ genişletmesini kapatın, sonra yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 无法收听这个标签页，因为 %2$@ 正在使用。请先为这个标签页关闭 %3$@，再试一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 無法收聽這個分頁，因為 %2$@ 正在使用。請先為這個分頁關閉 %3$@，再試一次。"
          }
        }
      }
    },
