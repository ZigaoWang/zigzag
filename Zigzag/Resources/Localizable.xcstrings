    "Drag a tab out to make it a tab of its own." : {
      "comment" : "Explanation under “Open ⌘-clicked links under their tab” in Settings › Tabs.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe einen Tab heraus, um ihn zu einem eigenständigen Tab zu machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drag a tab out to make it a tab of its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra una pestaña hacia fuera para que sea una pestaña independiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser un onglet vers l’extérieur pour en faire un onglet indépendant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina un pannello fuori per farne un pannello a sé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブをドラッグして外に出すと、独立したタブになります。"
