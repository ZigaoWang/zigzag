        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wordt afgemeld bij elke website. Je wachtwoorden, vastgezette tabbladen en geschiedenis blijven behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastąpi wylogowanie ze wszystkich witryn. Hasła, przypięte karty i historia pozostaną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você sairá de todos os sites. Suas senhas, abas fixadas e histórico permanecem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы выйдете из учётных записей на всех сайтах. Пароли, закреплённые вкладки и история останутся."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her sitedeki oturumunuz kapatılır. Parolalarınız, sabitlenmiş sekmeleriniz ve geçmişiniz kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将在所有网站上退出登录。你的密码、已固定标签页和历史记录会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你將在所有網站上結束登入。你的密碼、已固定分頁和瀏覽記錄會保留。"
          }
        }
      }
    },
    "You’ll be signed out of them, and their pages load fresh next time." : {
      "comment" : "Message of the sheet that removes the data of the sites a search shows in Settings › Privacy.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst bei ihnen abgemeldet, und ihre Seiten werden beim nächsten Mal neu geladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerrará tu sesión en ellos y sus páginas se cargarán desde cero la próxima vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous en serez déconnecté, et leurs pages seront entièrement rechargées la prochaine fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uscirai da questi siti e le loro pagine si caricheranno da zero la prossima volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのサイトからログアウトされ、次回はページが新しく読み込まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 사이트에서 로그아웃되며, 다음에는 페이지를 새로 로드합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wordt bij die websites afgemeld en hun pagina’s laden de volgende keer opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastąpi wylogowanie z nich, a ich strony wczytają się od nowa następnym razem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você sairá deles, e as páginas deles carregam do zero na próxima vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы выйдете из учётных записей на этих сайтах, а их страницы загрузятся заново в следующий раз."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumlarınız kapatılır ve sayfaları bir sonraki sefer yeniden yüklenir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将在这些网站上退出登录，下次会重新载入它们的页面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你將在這些網站上結束登入，下次會重新載入它們的網頁。"
          }
        }
      }
    },
