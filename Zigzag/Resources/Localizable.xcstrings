          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of laat Zigzag elke keer vragen waar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag może też za każdym razem pytać o miejsce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou deixe o Zigzag perguntar onde salvar a cada vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или Zigzag будет спрашивать, куда сохранять, каждый раз."
