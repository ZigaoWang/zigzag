          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag nie może odczytać tego pliku jako obrazu. Wybierz plik SVG, PNG, JPEG, HEIC, PDF lub ICNS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zigzag não consegue ler esse arquivo como imagem. Escolha um arquivo SVG, PNG, JPEG, HEIC, PDF ou ICNS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag не удаётся прочитать этот файл как изображение. Выберите файл SVG, PNG, JPEG, HEIC, PDF или ICNS."
