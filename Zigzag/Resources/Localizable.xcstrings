          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le password e gli accessi di %@ sono rimasti bloccati. Fai clic su Riprova, inserisci la password del Mac quando macOS la richiede e fai clic su Consenti."
