          }
        }
      }
    },
    "Passwords…" : {
      "comment" : "A row at the bottom of the fill-password menu: opens the Mac’s own list of passwords to pick one from, as Edit › AutoFill › Passwords… does in other apps.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
