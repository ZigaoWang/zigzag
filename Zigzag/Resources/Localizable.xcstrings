    "Continue where you left off" : {
      "comment" : "A choice for “On launch” in Settings › General: the last session's windows come back.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dort weitermachen, wo du aufgehört hast"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar donde lo dejaste"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprendre là où vous en étiez"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprendi da dove avevi lasciato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回の続きから"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중단한 곳에서 계속하기"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga verder waar je was gebleven"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontynuuj od miejsca, w którym skończono"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar de onde parou"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжить с того же места"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaldığınız yerden devam et"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接着上次继续"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接著上次繼續"
          }
        }
      }
    },
    "Continue where you left off brings back the windows and tabs you had. Open a new window starts with one window and keeps the last session in History › Reopen Last Session." : {
      "comment" : "Explanation under “On launch” in Settings › General.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Dort weitermachen, wo du aufgehört hast“ bringt deine Fenster und Tabs zurück. „Neues Fenster öffnen“ beginnt mit einem Fenster und behält die letzte Sitzung unter „Verlauf“ › „Letzte Sitzung wieder öffnen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar donde lo dejaste recupera las ventanas y pestañas que tenías. Abrir una ventana nueva empieza con una sola ventana y guarda la última sesión en Historial › Reabrir última sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprendre là où vous en étiez rouvre les fenêtres et les onglets que vous aviez. Ouvrir une nouvelle fenêtre démarre avec une seule fenêtre et conserve la dernière session dans Historique › Rouvrir la dernière session."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Riprendi da dove avevi lasciato” riporta le finestre e i pannelli che avevi. “Apri una nuova finestra” inizia con una sola finestra e conserva l’ultima sessione in Cronologia › Riapri l’ultima sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「前回の続きから」を選ぶと、前回のウインドウとタブが戻ります。「新規ウインドウを開く」を選ぶと、1つのウインドウで始まり、前回のセッションは「履歴 › 前回のセッションを再度開く」に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘중단한 곳에서 계속하기’를 선택하면 사용하던 윈도우와 탭이 다시 열립니다. ‘새로운 윈도우 열기’를 선택하면 윈도우 하나로 시작하고, 마지막 세션은 방문 기록 › 마지막 세션 다시 열기에 보관됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ga verder waar je was gebleven” brengt de vensters en tabbladen terug die je had. “Open een nieuw venster” begint met één venster en bewaart de laatste sessie in Geschiedenis › Open laatste sessie opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Kontynuuj od miejsca, w którym skończono” przywraca okna i karty, które były otwarte. „Otwórz nowe okno” zaczyna od jednego okna i zachowuje ostatnią sesję w „Historia” › „Otwórz ponownie ostatnią sesję”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar de onde parou traz de volta as janelas e abas que você tinha. Abrir uma nova janela começa com uma janela e mantém a última sessão em Histórico › Reabrir última sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Продолжить с того же места» возвращает окна и вкладки, которые у вас были. «Открыть новое окно» начинает с одного окна и оставляет прошлый сеанс в меню «История» › «Открыть последний сеанс снова»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Kaldığınız yerden devam et” pencerelerinizi ve sekmelerinizi geri getirir. “Yeni bir pencere aç” tek bir pencereyle başlar ve son oturumu Geçmiş › Son Oturumu Yeniden Aç’ta tutar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“接着上次继续”会带回你之前的窗口和标签页。“打开一个新窗口”只打开一个窗口，上次的会话可以在“历史记录 › 重新打开上次会话”里找回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「接著上次繼續」會帶回你之前的視窗和分頁。「開啟一個新視窗」只開啟一個視窗，上次的工作階段可以在「瀏覽記錄 › 重新開啟上次工作階段」裡找回。"
          }
        }
      }
    },
