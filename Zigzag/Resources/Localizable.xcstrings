    },
    "Put %s in the address where your search words go. Type the keyword in the address bar, then press Tab to search the site." : {
      "comment" : "Under the fields of the sheet that adds a site to Site Search in Settings › Search. Keep %s as it is: it's typed in the address.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze %s in der Adresse an die Stelle der Suchbegriffe. Gib das Schlüsselwort in die Adressleiste ein und drücke dann die Tabulatortaste, um die Website zu durchsuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon %s en la dirección donde van las palabras que buscas. Escribe la palabra clave en la barra de direcciones y pulsa Tab para buscar en el sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
