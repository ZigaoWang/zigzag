      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zertifikat der Website wurde von niemandem ausgestellt, dem dein Mac vertraut. Websites im eigenen Netzwerk, etwa ein Router, sehen oft so aus."
