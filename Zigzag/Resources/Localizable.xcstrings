            "state" : "translated",
            "value" : "此文件不在这里"
          }
        }
      }
    },
    "This is a browser theme, and Zigzag doesn’t use browser themes. To change how Zigzag looks, choose Edit Space… on a space and pick its colors." : {
      "comment" : "Shown instead of installing a theme from the Chrome Web Store or Firefox Add-ons. Edit Space… is the item in a space's right-click menu.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
