    "%@ may have changed or moved. Open it once, then try again." : {
      "comment" : "Message of the notice when an extension that comes inside an app can't install. The placeholder is the app, like StopTheMadness Pro.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde möglicherweise geändert oder bewegt. Öffne die App einmal und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que la app %@ haya cambiado o se haya movido. Ábrela una vez y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app %@ a peut-être été modifiée ou déplacée. Ouvrez-la une fois, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ potrebbe essere stato modificato o spostato. Aprilo una volta, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が変更または移動された可能性があります。一度開いてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 변경되었거나 이동되었을 수 있습니다. 한 번 연 다음 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is mogelijk gewijzigd of verplaatst. Open de app één keer en probeer het daarna opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja %@ mogła się zmienić lub zostać przeniesiona. Otwórz ją raz, a potem spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pode ter mudado ou sido movido. Abra-o uma vez e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение %@ могло быть изменено или перемещено. Откройте его один раз и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ değişmiş veya taşınmış olabilir. Bir kez açın, sonra yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 可能已更改或移动。请先打开它一次，然后再试一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 可能已變更或移動。請先開啟它一次，然後再試一次。"
          }
        }
      }
    },
    "%@ morning" : {
      "comment" : "Name of a History session that began in the last week. The placeholder is the weekday, like “Tuesday”.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@morgen"
