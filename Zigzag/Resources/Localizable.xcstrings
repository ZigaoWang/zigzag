    "Sites you visit can keep cookies and files here, to keep you signed in and load faster." : {
      "comment" : "Explanation under “None yet” in Settings › Privacy.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites, die du besuchst, können hier Cookies und Dateien ablegen, damit du angemeldet bleibst und sie schneller laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sitios que visitas pueden guardar aquí cookies y archivos, para mantener tu sesión y cargar más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sites que vous consultez peuvent conserver ici des cookies et des fichiers, pour vous garder connecté et se charger plus vite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I siti che visiti possono conservare qui cookie e file, per mantenerti connesso e caricarsi più velocemente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセスしたサイトは、ログイン状態を保ち速く読み込むために、ここにCookieやファイルを保存できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방문하는 사이트는 로그인 상태를 유지하고 더 빠르게 로드하기 위해 여기에 쿠키와 파일을 보관할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites die je bezoekt, kunnen hier cookies en bestanden bewaren om je aangemeld te houden en sneller te laden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odwiedzane witryny mogą tu zachowywać pliki cookie i pliki, aby utrzymać zalogowanie i szybciej się wczytywać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os sites que você visita podem guardar cookies e arquivos aqui, para manter você conectado e carregar mais rápido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сайты, которые вы посещаете, могут хранить здесь cookie и файлы, чтобы вы оставались в системе и страницы загружались быстрее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziyaret ettiğiniz siteler, oturumunuzu açık tutmak ve daha hızlı yüklenmek için çerezleri ve dosyaları burada saklayabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你访问的网站可以在这里保存 Cookie 和文件，让你保持登录，并加快载入速度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
