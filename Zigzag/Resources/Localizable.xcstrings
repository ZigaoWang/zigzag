    "Languages and sites you never translate show up here." : {
      "comment" : "Under Never Translate in Settings › Translation, when there's no language or site.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永不翻译的语言和网站会显示在这里。"
