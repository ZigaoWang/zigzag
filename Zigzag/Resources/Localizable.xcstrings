            "value" : "De app wordt verwijderd uit je map Programma’s. Je blijft aangemeld bij de website in Zigzag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja zostanie usunięta z folderu Aplikacje. Logowanie do witryny w Zigzag pozostaje."
