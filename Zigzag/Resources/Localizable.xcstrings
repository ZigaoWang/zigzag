    "This extension" : {
      "comment" : "Stands in for an extension's name on the bar over a Chrome Web Store page, before the page has a title.\nStands in for an extension's name when it has none, at the start of a sentence.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
