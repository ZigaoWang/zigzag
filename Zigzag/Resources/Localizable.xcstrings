    "%lld downloads are still in progress. They pause, and you can resume them from Downloads when you open Zigzag again." : {
      "comment" : "Message of the sheet that asks before quitting while files download.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ein Download läuft noch. Er wird angehalten und du kannst ihn unter „Downloads“ fortsetzen, wenn du Zigzag wieder öffnest."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Downloads laufen noch. Sie werden angehalten und du kannst sie unter „Downloads“ fortsetzen, wenn du Zigzag wieder öffnest."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "A download is still in progress. It pauses, and you can resume it from Downloads when you open Zigzag again."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld downloads are still in progress. They pause, and you can resume them from Downloads when you open Zigzag again."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Hay %lld descargas en curso. Se pausan y puedes reanudarlas desde Descargas cuando vuelvas a abrir Zigzag."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Hay una descarga en curso. Se pausa y puedes reanudarla desde Descargas cuando vuelvas a abrir Zigzag."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Hay %lld descargas en curso. Se pausan y puedes reanudarlas desde Descargas cuando vuelvas a abrir Zigzag."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Un téléchargement est toujours en cours. Il sera mis en pause et vous pourrez le reprendre depuis Téléchargements à la prochaine ouverture de Zigzag."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld téléchargements sont toujours en cours. Ils seront mis en pause et vous pourrez les reprendre depuis Téléchargements à la prochaine ouverture de Zigzag."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Un download è ancora in corso. Viene messo in pausa e puoi riprenderlo da Download alla prossima apertura di Zigzag."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld download sono ancora in corso. Vengono messi in pausa e puoi riprenderli da Download alla prossima apertura di Zigzag."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
