        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je tabbladen en spaces staan hier weer klaar wanneer je Zigzag opnieuw opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karty i przestrzenie będą tu, gdy znów otworzysz Zigzag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas abas e espaços estarão aqui quando você abrir novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши вкладки и пространства будут здесь, когда вы снова откроете Zigzag."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden açtığınızda sekmeleriniz ve Space’leriniz tam burada olacak."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次打开时，你的标签页和空间都会在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次開啟時，你的分頁和空間都會在這裡。"
          }
        }
      }
    },
    "Your windows and tabs come back as they are. Or it switches the next time you open Zigzag." : {
      "comment" : "Message of the sheet after picking a language in Settings › General.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Fenster und Tabs kommen so zurück, wie sie sind. Oder die Sprache wechselt beim nächsten Öffnen von Zigzag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus ventanas y pestañas vuelven tal como están. Si no, el idioma cambiará la próxima vez que abras Zigzag."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos fenêtres et vos onglets reviennent tels quels. Sinon, la langue changera à la prochaine ouverture de Zigzag."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finestre e pannelli tornano come sono. Oppure la lingua cambierà alla prossima apertura di Zigzag."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウとタブはそのままの状態で戻ります。次にZigzagを開いたときに切り替えることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우와 탭이 그대로 다시 열립니다. 또는 다음에 Zigzag를 열 때 언어가 변경됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je vensters en tabbladen komen terug zoals ze waren. Of de taal verandert de volgende keer dat je Zigzag opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okna i karty wrócą w niezmienionej postaci. Możesz też poczekać: zmiana nastąpi przy następnym otwarciu Zigzag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas janelas e abas voltam como estão. Ou muda na próxima vez que você abrir o Zigzag."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши окна и вкладки вернутся как были. Или язык сменится при следующем открытии Zigzag."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencereleriniz ve sekmeleriniz olduğu gibi geri gelir. Ya da dil, Zigzag’i bir sonraki açışınızda değişir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的窗口和标签页会原样回来。也可以等下次打开 Zigzag 时再切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的視窗和分頁會原樣回來。也可以等下次開啟 Zigzag 時再切換。"
          }
        }
      }
    },
    "You’ll be signed out of %@, and its pages load fresh next time." : {
      "comment" : "Message of the sheet that removes one site's data.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst bei %@ abgemeldet, und die Seiten werden beim nächsten Mal neu geladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerrará tu sesión en %@ y sus páginas se cargarán desde cero la próxima vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous serez déconnecté du site %@, et ses pages seront entièrement rechargées la prochaine fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uscirai da %@ e le sue pagine si caricheranno da zero la prossima volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@からログアウトされ、次回はページが新しく読み込まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 로그아웃되며, 다음에는 페이지를 새로 로드합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wordt afgemeld bij %@ en de pagina’s laden de volgende keer opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastąpi wylogowanie z witryny %@, a jej strony wczytają się od nowa następnym razem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você sairá de %@, e as páginas dele carregam do zero na próxima vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы выйдете из учётной записи на %@, а страницы сайта загрузятся заново в следующий раз."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sitesindeki oturumunuz kapatılır ve sayfaları bir sonraki sefer yeniden yüklenir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将退出 %@ 的登录，下次会重新载入它的页面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你將結束 %@ 的登入，下次會重新載入它的網頁。"
          }
        }
      }
    },
    "You’ll be signed out of %@. Other sites aren’t touched." : {
      "comment" : "Message of the sheet that asks before clearing one site's cookies.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst bei %@ abgemeldet. Andere Websites bleiben unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerrará tu sesión en %@. Los demás sitios no se tocan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous serez déconnecté du site %@. Les autres sites ne sont pas concernés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uscirai da %@. Gli altri siti non vengono toccati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@からログアウトされます。ほかのサイトには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 로그아웃됩니다. 다른 사이트에는 영향이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wordt afgemeld bij %@. Andere websites blijven ongemoeid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastąpi wylogowanie z witryny %@. Inne witryny pozostaną nietknięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você sairá de %@. Os outros sites não são afetados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы выйдете из учётной записи на %@. Другие сайты не затрагиваются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sitesindeki oturumunuz kapatılır. Diğer sitelere dokunulmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将退出 %@ 的登录。其他网站不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你將結束 %@ 的登入。其他網站不受影響。"
          }
        }
      }
    },
    "You’ll be signed out of every site, and pages load fresh next time. Your passwords, pinned tabs and history stay." : {
      "comment" : "Message of the sheet that removes every site's data, from Remove All in Settings › Privacy › Stored by Websites.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst bei allen Websites abgemeldet, und Seiten werden beim nächsten Mal neu geladen. Deine Passwörter, fixierten Tabs und dein Verlauf bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerrará tu sesión en todos los sitios y las páginas se cargarán desde cero la próxima vez. Tus contraseñas, pestañas fijadas e historial se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous serez déconnecté de tous les sites, et les pages seront entièrement rechargées la prochaine fois. Vos mots de passe, onglets épinglés et historique sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uscirai da tutti i siti e le pagine si caricheranno da zero la prossima volta. Password, pannelli fissati e cronologia restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのサイトからログアウトされ、次回はページが新しく読み込まれます。パスワード、固定タブ、履歴は残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 사이트에서 로그아웃되며, 다음에는 페이지를 새로 로드합니다. 암호, 고정된 탭 및 방문 기록은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wordt afgemeld bij elke website en pagina’s laden de volgende keer opnieuw. Je wachtwoorden, vastgezette tabbladen en geschiedenis blijven behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastąpi wylogowanie ze wszystkich witryn, a strony wczytają się od nowa następnym razem. Hasła, przypięte karty i historia pozostaną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você sairá de todos os sites, e as páginas carregam do zero na próxima vez. Suas senhas, abas fixadas e histórico permanecem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы выйдете из учётных записей на всех сайтах, а страницы загрузятся заново в следующий раз. Пароли, закреплённые вкладки и история останутся."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her sitedeki oturumunuz kapatılır ve sayfalar bir sonraki sefer yeniden yüklenir. Parolalarınız, sabitlenmiş sekmeleriniz ve geçmişiniz kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将在所有网站上退出登录，下次会重新载入页面。你的密码、已固定标签页和历史记录会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你將在所有網站上結束登入，下次會重新載入網頁。你的密碼、已固定分頁和瀏覽記錄會保留。"
          }
        }
      }
    },
