          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Mac laat Zigzag dit niet openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac nie pozwala Zigzag otworzyć tej strony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu Mac não deixa o Zigzag abrir isto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш Mac не позволяет Zigzag открыть это."
          }
        },
        "tr" : {
          "stringUnit" : {
