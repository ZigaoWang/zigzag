      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要导入 Safari 的书签和历史记录，请从 Safari 导出（文件 › 将浏览数据导出到文件），然后在这里选择该文件。其他内容无需你的许可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要匯入 Safari 的書籤和瀏覽記錄，請從 Safari 匯出（檔案 › 將瀏覽資料匯出到檔案），然後在這裡選取該檔案。其他內容無需你的許可。"
          }
        }
      }
    },
    "To separate them, press %@" : {
