{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@" : {
      "comment" : "Joins two sentences, one after the other. Leave out the space if your language doesn't put one between sentences.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@"
          }
        }
      }
    },
    "%@ (%@)" : {
      "comment" : "A button's tooltip: its name, then its keyboard shortcut in parentheses, like “Reload (⌘R)”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@）"
          }
        }
      }
    },
    "%@ (System)" : {
      "comment" : "The first choice of Translate pages into, in Settings › Translation: the Mac's language, by name.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（系统）"
          }
        }
      }
    },
    "%@ afternoon" : {
      "comment" : "Name of a History session that began in the last week. The placeholder is the weekday, like “Tuesday”.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@下午"
          }
        }
      }
    },
    "%@ afternoon, %@" : {
      "comment" : "Name of an older History session: the weekday, then the date, like “Sunday afternoon, October 18”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ afternoon, %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ %1$@下午"
          }
        }
      }
    },
    "%@ and %@" : {
      "comment" : "Under a space's name in Settings › Spaces: its pinned tabs, then its open tabs, like “3 pinned tabs and 2 open tabs”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ and %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@和 %2$@"
          }
        }
      }
    },
    "%@ can be your search engine" : {
      "comment" : "Toast after adding an extension that gives a search engine. The name is the engine's, like ChatGPT.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以把 %@ 设为你的搜索引擎"
          }
        }
      }
    },
    "%@ can’t prove it is who it says it is, so Zigzag didn’t open it." : {
      "comment" : "Message on the page Zigzag shows when a page can't load. The placeholder is the site's host name.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法证明自己的身份，所以 Zigzag 没有打开它。"
          }
        }
      }
    },
    "%@ evening" : {
      "comment" : "Name of a History session that began in the last week. The placeholder is the weekday, like “Tuesday”.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@晚上"
          }
        }
      }
    },
    "%@ evening, %@" : {
      "comment" : "Name of an older History session: the weekday, then the date, like “Sunday afternoon, October 18”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ evening, %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ %1$@晚上"
          }
        }
      }
    },
    "%@ from %@" : {
      "comment" : "Under a download's name in the downloads panel: the file's size and the site it came from, like 9 MB from example.com.\nUnder the big number when an import finishes: what it counts, then a browser's name, like “passwords from Arc”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ from %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，来自 %2$@"
          }
        }
      }
    },
    "%@ has a primary password. Type it to bring its passwords over." : {
      "comment" : "Problem in the Import window. The placeholder is a browser's name, like Firefox; primary password is Firefox's own term.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 设置了主密码。输入主密码即可导入其中的密码。"
          }
        }
      }
    },
    "%@ is listening to this tab" : {
      "comment" : "Toast when an extension starts hearing a tab's sound. The placeholder is the extension's name.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在收听此标签页"
          }
        }
      }
    },
    "%@ is on a port kept for other things, like email, so browsers don’t open it." : {
      "comment" : "Message on the page Zigzag shows when a page can't load. The placeholder is the site's host name.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 使用的端口留作电子邮件等其他用途，所以浏览器不会打开它。"
          }
        }
      }
    },
    "%@ isn’t a Safari export Zigzag can open. In Safari, choose File › Export Browsing Data, then choose the zip it makes." : {
      "comment" : "Problem in the Import window. The placeholder is the file's name; File › Export Browsing Data is Safari's own menu wording.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是 Zigzag 能打开的 Safari 导出文件。在 Safari 中，选取“文件 › 导出浏览数据”，然后选择它生成的 zip 文件。"
          }
        }
      }
    },
    "%@ isn’t a password export Zigzag recognizes. Export a CSV from your password manager or browser and choose it." : {
      "comment" : "Problem in the Import window. The placeholder is the chosen file's name.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是 Zigzag 能识别的密码导出文件。请从你的密码管理器或浏览器导出 CSV 文件，然后选择它。"
          }
        }
      }
    },
    "%@ keeps its %lld passwords in a newer format Zigzag can’t read yet. Export them from %@’s Passwords page as a CSV file, then choose it here." : {
      "comment" : "Problem in the Import window. The placeholders are a browser's name, like Firefox, and how many passwords it has.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ keeps its %2$lld passwords in a newer format Zigzag can’t read yet. Export them from %3$@’s Passwords page as a CSV file, then choose it here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 的 %2$lld 个密码使用了 Zigzag 暂时无法读取的新格式。请在 %3$@ 的“密码”页面将它们导出为 CSV 文件，然后在这里选择。"
          }
        }
      }
    },
    "%@ keeps sending you around" : {
      "comment" : "Title of the page Zigzag shows when a page can't load. The placeholder is the site's host name.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 一直在来回跳转"
          }
        }
      }
    },
    "%@ late night" : {
      "comment" : "Name of a History session that began in the last week. The placeholder is the weekday, like “Tuesday”. Between midnight and 5 AM.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@凌晨"
          }
        }
      }
    },
