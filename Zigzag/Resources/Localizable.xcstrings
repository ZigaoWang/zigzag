    },
    "This site is blocked on this Mac" : {
      "comment" : "Title of the page Zigzag shows when Screen Time or a content filter blocks a site.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此网站在这台 Mac 上受到限制"
