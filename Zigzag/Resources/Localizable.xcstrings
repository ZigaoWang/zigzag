        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或者點一下側邊欄中的 +，然後選取「新增空間」"
          }
        }
      }
    },
    "Or have Zigzag ask where, each time." : {
      "comment" : "Explanation under “Save downloads to” in Settings › General.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder lass Zigzag jedes Mal fragen, wohin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O haz que Zigzag pregunte dónde, cada vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou laissez Zigzag demander l’emplacement à chaque fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure lascia che Zigzag ti chieda dove, ogni volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "または、毎回保存先をZigzagに確認させることもできます。"
