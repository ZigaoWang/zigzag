    "The page is pinned in %@. Add to Favorites shows it in all of the profile’s spaces instead." : {
      "comment" : "Under the title of the sheet that pins a page: the space it's pinned in, which the sheet doesn't let you change, and what Add to Favorites means. The placeholder is the space's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Seite wird in „%@“ fixiert. „Zu Favoriten hinzufügen“ zeigt sie stattdessen in allen Spaces des Profils."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La página se fija en %@. Añadir a favoritos la muestra en todos los espacios del perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La page est épinglée dans %@. Ajouter aux favoris l’affiche plutôt dans tous les espaces du profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pagina viene fissata in %@. Con Aggiungi ai preferiti compare invece in tutti gli spazi del profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページは「%@」に固定されます。「お気に入りに追加」を使うと、プロファイルのすべてのスペースに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페이지가 %@에 고정됩니다. 즐겨찾기에 추가하면 대신 프로필의 모든 스페이스에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De pagina is vastgezet in %@. Met Voeg toe aan favorieten wordt de pagina in plaats daarvan in alle spaces van het profiel getoond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strona jest przypięta w przestrzeni „%@”. „Dodaj do ulubionych” pokazuje ją zamiast tego we wszystkich przestrzeniach profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A página é fixada no espaço %@. Adicionar aos favoritos a mostra em todos os espaços do perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Страница закреплена в «%@». «Добавить в избранное» покажет её во всех пространствах профиля."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayfa “%@” Space’inde sabitlenir. “Favorilere Ekle” bunun yerine onu profilin tüm Space’lerinde gösterir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "页面会固定在“%@”中。“添加到收藏”则会让它显示在个人资料的所有空间中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "網頁會固定在「%@」中。「新增到收藏」則會讓它顯示在個人資料的所有空間中。"
          }
        }
      }
    },
    "The group is pinned in %@ as a folder, with all of its tabs." : {
      "comment" : "Under the title of the sheet that pins a tab group: the space it's pinned in as a folder, which the sheet doesn't let you change. The placeholder is the space's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gruppe wird in „%@“ als Ordner mit all ihren Tabs fixiert."
          }
        },
        "es" : {
