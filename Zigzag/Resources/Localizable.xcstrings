    "Click a shortcut to change or remove it. To find one, type its name or keys in Find a setting." : {
      "comment" : "Hint at the top of Settings › Shortcuts. “Find a setting” is the search field's placeholder.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf einen Kurzbefehl, um ihn zu ändern oder zu entfernen. Gib zum Finden seinen Namen oder seine Tasten unter „Einstellung suchen“ ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en un atajo para cambiarlo o quitarlo. Para encontrar uno, escribe su nombre o sus teclas en Buscar un ajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur un raccourci pour le modifier ou le supprimer. Pour en trouver un, saisissez son nom ou ses touches dans Rechercher un réglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su una scorciatoia per cambiarla o rimuoverla. Per trovarne una, digita il nome o i tasti in Trova un’impostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットをクリックすると、変更または削除できます。探すときは、「設定を検索」に名前かキーを入力します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키를 클릭하면 변경하거나 제거할 수 있습니다. 단축키를 찾으려면 ‘설정 찾기’에 이름이나 키를 입력하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op een toetscombinatie om die te wijzigen of te verwijderen. Typ de naam of de toetsen in Zoek een instelling om er een te vinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij skrót, aby go zmienić lub usunąć. Aby go znaleźć, wpisz jego nazwę lub klawisze w polu „Znajdź ustawienie”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em um atalho para alterá-lo ou removê-lo. Para encontrar um, digite o nome ou as teclas dele em Buscar um ajuste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
