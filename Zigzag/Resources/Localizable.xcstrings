    "Zigzag couldn’t read the site’s certificate, so it can’t be trusted anyway." : {
      "comment" : "Under Details on the page Zigzag shows for a site whose certificate can't be trusted, in place of Visit this site anyway, when the certificate couldn't be read.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag konnte das Zertifikat der Website nicht lesen, daher kann sie nicht trotzdem besucht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag no pudo leer el certificado del sitio, así que no se puede confiar en él de todos modos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag n’a pas pu lire le certificat du site : il ne peut donc pas être approuvé."
