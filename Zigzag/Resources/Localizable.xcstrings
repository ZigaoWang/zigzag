    "This site’s password rules didn’t fit a strong password. Type one yourself." : {
      "comment" : "Toast when Zigzag couldn't make a strong password the site accepts.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Passwortregeln dieser Website passen nicht zu einem starken Passwort. Gib selbst eines ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas de contraseña de este sitio no admiten una contraseña segura. Escribe una tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les règles de mot de passe de ce site ne permettent pas de mot de passe fort. Saisissez-en un vous-même."
          }
        },
        "it" : {
          "stringUnit" : {
