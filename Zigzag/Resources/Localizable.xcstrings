        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароли в %@ остались заблокированными. Нажмите «Повторить», введите пароль вашего Mac, когда его запросит macOS, и нажмите «Разрешить»."
          }
        },
        "tr" : {
          "stringUnit" : {
