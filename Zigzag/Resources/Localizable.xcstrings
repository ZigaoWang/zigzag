    "Zigzag can’t read that file as a picture. Choose a photo or an image file, like a JPEG, PNG or HEIC." : {
      "comment" : "Message of the notice when a picture chosen for a space's empty page can't be read.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag kann diese Datei nicht als Bild lesen. Wähle ein Foto oder eine Bilddatei, etwa JPEG, PNG oder HEIC."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag no puede leer ese archivo como imagen. Elige una foto o un archivo de imagen, como JPEG, PNG o HEIC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag ne peut pas lire ce fichier comme une image. Choisissez une photo ou un fichier image, comme JPEG, PNG ou HEIC."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag non riesce a leggere quel file come immagine. Scegli una foto o un file immagine, come JPEG, PNG o HEIC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzagはこのファイルを画像として読み込めません。JPEG、PNG、HEICなどの写真か画像ファイルを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag가 해당 파일을 이미지로 읽을 수 없습니다. JPEG, PNG 또는 HEIC 같은 사진이나 이미지 파일을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag kan dat bestand niet als afbeelding lezen. Kies een foto of afbeeldingsbestand, zoals een JPEG, PNG of HEIC."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag nie może odczytać tego pliku jako obrazu. Wybierz zdjęcie lub plik obrazu, na przykład JPEG, PNG lub HEIC."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zigzag não consegue ler esse arquivo como imagem. Escolha uma foto ou um arquivo de imagem, como JPEG, PNG ou HEIC."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag не удаётся прочитать этот файл как картинку. Выберите фото или файл изображения, например JPEG, PNG или HEIC."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag bu dosyayı resim olarak okuyamıyor. JPEG, PNG veya HEIC gibi bir fotoğraf veya resim dosyası seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 无法将该文件读取为图像。请选取照片或图像文件，例如 JPEG、PNG 或 HEIC。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 無法將該檔案讀取為影像。請選取照片或影像檔案，例如 JPEG、PNG 或 HEIC。"
          }
        }
      }
    },
