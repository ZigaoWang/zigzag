    "Couldn’t check for updates. Try again later." : {
      "comment" : "Toast when Check for Updates… or Restart to Update can't reach the update feed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche nach Updates fehlgeschlagen. Versuche es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo comprobar si hay actualizaciones. Inténtalo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de rechercher les mises à jour. Réessayez plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile controllare gli aggiornamenti. Riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートを確認できませんでした。あとでもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트를 확인할 수 없습니다. 나중에 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan niet zoeken naar updates. Probeer het later opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się sprawdzić aktualizacji. Spróbuj ponownie później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível buscar atualizações. Tente novamente mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось проверить обновления. Повторите попытку позже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
