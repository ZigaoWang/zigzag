            "value" : "Contraseñas, marcadores, historial y extensiones, de cualquier navegador de este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mots de passe, signets, historique et extensions, depuis n’importe quel navigateur de ce Mac."
          }
        },
