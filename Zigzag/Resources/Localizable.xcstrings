    "%@ muted" : {
      "comment" : "Spoken by VoiceOver after a tab row's name, for one page of a split: that page's title, then that it's muted."
    },
    "%@ needs its app" : {
      "comment" : "Title of the note shown from an extension's button when its companion app isn't installed. The placeholder is the extension's name."
    },
    "%@ night" : {
      "comment" : "Name of a History session that began in the last week. The placeholder is the weekday, like “Tuesday”."
    },
    "%@ night, %@" : {
      "comment" : "Name of an older History session: the weekday, then the date, like “Sunday afternoon, October 18”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ night, %2$@"
