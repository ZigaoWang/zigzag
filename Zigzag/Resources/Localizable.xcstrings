    },
    "Switch to Tab" : {
      "comment" : "Action label at the right of the selected command bar result, saying what Return does: goes to the open tab.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换到标签页"
          }
        }
