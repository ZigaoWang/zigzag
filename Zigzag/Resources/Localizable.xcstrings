    "%@ has a primary password. Type it to bring its passwords over." : {
      "comment" : "Problem in the Import window. The placeholder is a browser's name, like Firefox; primary password is Firefox's own term.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat ein Hauptpasswort. Gib es ein, um die Passwörter zu übernehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiene una contraseña principal. Escríbela para traer sus contraseñas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est protégé par un mot de passe principal. Saisissez-le pour importer ses mots de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha una password principale. Digitala per importarne le password."
          }
        },
        "ja" : {
