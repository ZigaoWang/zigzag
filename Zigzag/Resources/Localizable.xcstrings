          }
        }
      }
    },
    "%@ has no bookmarks Zigzag can read. Export your bookmarks as an HTML file from your browser, then choose it." : {
      "comment" : "Problem in the Import window. The placeholder is the chosen file's name.",
      "localizations" : {
        "zh-Hans" : {
