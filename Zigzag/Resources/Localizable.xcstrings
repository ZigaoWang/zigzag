    },
    "%@ of %@" : {
      "comment" : "Under a download's name in the downloads panel: how much has come of how much, like 3.7 MB of 9 MB.\nUnder a download's name in the downloads panel: how much has come of how much, the unit said once, like 3.7 of 9 MB.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@"
          }
        }
      }
    },
    "%@ playing audio" : {
      "comment" : "Spoken by VoiceOver after a tab row's name, for one page of a split: that page's title, then that it plays sound."
    },
    "%@ says" : {
      "comment" : "Title of a page's JavaScript alert, confirm or prompt sheet. The placeholder is the site's host name, or “This page”."
    },
    "%@ sent a broken page" : {
      "comment" : "Title of the page Zigzag shows when a page can't load. The placeholder is the site's host name."
    },
    "%@ side panel" : {
      "comment" : "What VoiceOver calls an extension's side panel. The placeholder is the extension's name."
    },
    "%@ stays pinned to its own page" : {
      "comment" : "Toast after closing a pinned tab that had wandered to another page. The title is the pinned tab's."
    },
    "%@ to %@" : {
      "comment" : "The time a session or a site's pages span on the History page, like “2:10 to 4:45 PM”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ to %2$@"
          }
        }
      }
    },
    "%@ took too long" : {
      "comment" : "Title of the page Zigzag shows when a page can't load. The placeholder is the site's host name."
    },
    "%@ wants a certificate" : {
      "comment" : "Title of the page Zigzag shows when a page can't load. The placeholder is the site's host name."
    },
    "%@ wants more access" : {
      "comment" : "Title of the sheet shown when an extension's update asks for more access. The name is the extension's."
    },
    "%@ works together with an app on your Mac, and Zigzag couldn’t find it. Install the app, then reopen Zigzag." : {
      "comment" : "Shown from an extension's button when its companion app isn't installed. The placeholder is the extension's name."
    },
    "%@, %@" : {
      "comment" : "Accessibility label of the address in the sidebar on a plain http page: the site, then that it's not secure.\nJoins the items of a short list in the Import window, like “6 passwords, history”.\nUnder a download's name in the downloads panel: how much has come, then the time left, like 3.7 of 9 MB, a minute left.\nVoiceOver name of a command bar result: its title, then what's under it.\nVoiceOver name of a download in the downloads panel: the file's name, then what's under it.\nWhat VoiceOver says for a row in the Passwords window: the site, then the username.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@, %lld percent color" : {
      "comment" : "VoiceOver, in the space editor's color wheel: a knob's color family, then how much color, like “Blue, 40 percent color”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$lld percent color"
          }
        }
      }
    },
    "%@, by %@" : {
      "comment" : "Under an article's title in Reader: the site it's from, then who wrote it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, by %2$@"
          }
        }
      }
    },
    "%@, folder, %lld pinned" : {
      "comment" : "Accessibility label of a folder in the sidebar: its name, then how many pinned tabs it holds.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, folder, %2$lld pinned"
          }
        }
      }
    },
    "%@, pinned tabs hidden" : {
      "comment" : "Accessibility label of the space's name above its pinned tabs, while they're folded away."
    },
    "%@, split with %@" : {
      "comment" : "Accessibility label of a split view's row in the sidebar: the two pages' titles.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, split with %2$@"
          }
        }
      }
    },
    "%@. %@." : {
      "comment" : "A save that failed, then why, as two sentences: “Couldn’t save the page. Not enough space on your Mac.”",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. %2$@."
          }
        }
      }
    },
    "%@: %@" : {
      "comment" : "Accessibility label of a shortcut in Settings › Shortcuts: the command, then its keys.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%@: %@?" : {
      "comment" : "VoiceOver label of a site's permission question: the site, then its request, like “zoom.us: Use your camera?”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@?"
          }
        }
      }
    },
    "%@: in its settings, choose Browser, then Add Browser" : {
      "comment" : "Toast when an extension needs a step in its own app. The placeholder is a title like “Connect 1Password to Zigzag”. Browser and Add Browser are names in 1Password's settings."
    },
    "%@: needs attention" : {
      "comment" : "Tooltip of an extension's button in the site panel when the extension asks for attention. The name is the extension's."
    },
    "%@: no shortcut" : {
      "comment" : "Accessibility label of a command with no keys in Settings › Shortcuts."
    },
    "%@: page" : {
      "comment" : "The address bar's name for a page with no site, like a data: page. The placeholder is the address's scheme, like “data”."
    },
    "%@?" : {
      "comment" : "A site's permission question: the request, then a question mark, like “Use your camera?”."
    },
    "%@’s page is using a lot of energy" : {
      "comment" : "Toast when an extension's own page uses a lot of energy. The name is the extension's."
    },
    "%@’s passwords and sign-ins stayed locked. Click Try Again, type your Mac’s password when macOS asks, and click Always Allow." : {
      "comment" : "Problem in the Import window. The placeholder is a browser's name, like Chrome; Try Again is a button here, Always Allow is macOS's own button."
    },
    "%@’s passwords are in a format Zigzag can’t read. Export them from %@’s Passwords page as a CSV file, then choose it here." : {
