            "value" : "Tu nombre, correo electrónico, teléfono y dirección, de tu propia tarjeta de Contactos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos nom, e-mail, téléphone et adresse, depuis votre propre fiche dans Contacts."
