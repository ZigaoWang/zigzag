    },
    "Its package is damaged." : {
      "comment" : "One line beside an extension's name when its update's package is damaged.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的安装包已损坏。"
          }
        }
