    "Switch to your new space" : {
      "comment" : "The last step's title in the getting-started guide, a card in the window, when you're still in the space you started in.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换到你的新空间"
