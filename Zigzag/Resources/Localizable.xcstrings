    "Paste it where the app adds MCP servers. Most apps take this form." : {
      "comment" : "Explanation under “Setup” in Settings › Automation › Connect an App.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge dies dort ein, wo die App MCP-Server hinzufügt. Die meisten Apps verwenden dieses Format."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pégalo donde la app añade servidores MCP. La mayoría de las apps aceptan este formato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez-la là où l’app ajoute des serveurs MCP. La plupart des apps acceptent ce format."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incollalo dove l’app aggiunge i server MCP. La maggior parte delle app accetta questo formato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppでMCPサーバを追加する場所にペーストしてください。ほとんどのAppはこの形式に対応しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱에서 MCP 서버를 추가하는 곳에 붙여넣으세요. 대부분의 앱에서 이 형식을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plak het waar de app MCP-servers toevoegt. De meeste apps accepteren deze vorm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wklej to tam, gdzie aplikacja dodaje serwery MCP. Większość aplikacji przyjmuje tę postać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cole onde o app adiciona servidores MCP. A maioria dos apps aceita este formato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставьте это туда, где приложение добавляет серверы MCP. Так это принимает большинство приложений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın MCP sunucuları eklediği yere yapıştırın. Çoğu uygulama bu biçimi kabul eder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴到 App 添加 MCP 服务器的地方。大多数 App 都接受这种格式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼上到 App 新增 MCP 伺服器的地方。大多數 App 都接受這種格式。"
          }
        }
      }
    },
