    },
    "Never Translate This Site" : {
      "comment" : "Item in the translate menu: pages on this site are never offered or translated on their own.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永不翻译此网站"
          }
        }
      }
    },
    "Open Link in Zigzag Mini" : {
      "comment" : "Item in a page's right-click menu: opens the link in Zigzag Mini, the small window for one page, over this one (Arc called it Little Arc).",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Zigzag Mini 中打开链接"
          }
        }
      }
    },
    "Or press ⌘O to keep it as a tab" : {
      "comment" : "Under the hint to close Zigzag Mini, the small window a shift-clicked link opened in, in the getting-started guide, a card in the window.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或者按 ⌘O 把它留作标签页"
          }
        }
      }
    },
    "Pine" : {
      "comment" : "Name of a curated space color, in the space editor. A deep pine green.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "松绿"
          }
        }
      }
    },
    "Seafoam" : {
      "comment" : "Name of a curated space color, in the space editor. A soft mint green.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海沫"
          }
        }
      }
    },
    "Since %@" : {
      "comment" : "On Your Zigzag Card, under the name: the day Zigzag was first used on this Mac. The placeholder is the date, like November 8, 2026.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自 %@ 起"
          }
        }
      }
    },
    "Azure" : {
      "comment" : "Name of a curated space color, in the space editor. A clear sky blue.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蔚蓝"
          }
        }
      }
    },
    "That’s Zigzag Mini" : {
      "comment" : "Said once a step is done in the getting-started guide, a card in the window: a shift-clicked link opened in Zigzag Mini, the small window for one page. Keep Zigzag Mini in Latin letters.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这就是 Zigzag Mini"
          }
        }
      }
    },
    "Translated" : {
      "comment" : "Tooltip of the address bar's translate button on a translated page.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已翻译"
          }
        }
      }
    },
    "Translation Settings…" : {
      "comment" : "Item in the translate menu: opens Settings › Translation.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻译设置…"
          }
        }
      }
    },
    "Coral" : {
      "comment" : "Name of a curated space color, in the space editor. A warm coral orange.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "珊瑚"
          }
        }
      }
    },
    "user-agent.default" : {
      "comment" : "First choice in the User agent dropdown of the site panel: the site gets Zigzag's own user agent, as any site.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
