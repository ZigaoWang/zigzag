    "This rule sends the file itself, but there was no file to send. Set Hand off to File, and let the download finish first." : {
      "comment" : "Why a download rule failed: its parameters use {file_raw}, which needs the saved file, but no file was handed off.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Regel sendet die Datei selbst, aber es gab keine Datei zum Senden. Stelle „Übergeben“ auf „Datei“ und lass den Download zuerst fertig werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta regla envía el propio archivo, pero no había ningún archivo que enviar. Ajusta Enviar en Archivo y deja que la descarga termine primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette règle envoie le fichier lui-même, mais il n’y avait aucun fichier à envoyer. Réglez « Transférer » sur « Fichier » et laissez d’abord le téléchargement se terminer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa regola invia il file stesso, ma non c’era nessun file da inviare. Imposta Trasferisci su File e lascia prima terminare il download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このルールはファイルそのものを送りますが、送るファイルがありませんでした。「渡すもの」を「ファイル」にして、ダウンロードが完了するまで待ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 규칙은 파일 자체를 보내지만 보낼 파일이 없었습니다. 전달을 파일로 설정하고 먼저 다운로드가 완료될 때까지 기다리세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze regel stuurt het bestand zelf, maar er was geen bestand om te sturen. Zet Doorgeven op Bestand en laat de download eerst voltooien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta reguła wysyła sam plik, ale nie było pliku do wysłania. Ustaw opcję Przekaż na Plik i najpierw poczekaj na ukończenie pobierania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta regra envia o próprio arquivo, mas não havia arquivo para enviar. Defina Entregar como Arquivo e deixe o download terminar primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это правило отправляет сам файл, но отправлять было нечего. Выберите «Файл» в поле «Передача» и дождитесь окончания загрузки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kural dosyanın kendisini gönderir, ancak gönderilecek dosya yoktu. Devret’i Dosya olarak ayarlayın ve önce indirmenin bitmesini bekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这条规则会发送文件本身，但没有可发送的文件。请把“转交”设为“文件”，并等下载完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這條規則會傳送檔案本身，但沒有可傳送的檔案。請把「轉交」設為「檔案」，並等下載完成。"
          }
        }
      }
    },
    "This file is too large to send that way (%@)." : {
      "comment" : "Why a download rule failed: the file is bigger than a rule can send as {file_raw}. The placeholder is a size, like 40 MB.",
      "localizations" : {
        "de" : {
