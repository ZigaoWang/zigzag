{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAudioCaptureUsageDescription" : {
      "comment" : "Shown by macOS when an extension first listens to a tab's sound. Shazam is a product name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Extensions you use, like Shazam, can hear what a tab plays, only while they listen."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Shown by macOS when a website first asks to use the camera.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Websites you visit can ask to use your camera."
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Shown by macOS when Zigzag first asks to read the person's own card in Contacts, to fill forms.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Zigzag fills your name, email, phone and address into forms from your own card in Contacts."
          }
        }
      }
    },
    "NSDownloadsFolderUsageDescription" : {
      "comment" : "Shown by macOS when Zigzag first saves into the Downloads folder.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Zigzag saves the files you download here."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Shown by macOS when a website first reaches a device on the local network.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Websites you visit can ask to connect to devices on your local network."
          }
        }
      }
    },
    "NSLocationUsageDescription" : {
