{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAudioCaptureUsageDescription" : {
      "comment" : "Shown by macOS when an extension first listens to a tab's sound. Shazam is a product name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Extensions you use, like Shazam, can hear what a tab plays, only while they listen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shazamなど、使用している機能拡張は、聞き取っているあいだだけ、タブで再生中の音を聞くことができます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你使用的扩展（比如 Shazam）可以听到标签页播放的声音，但只在它们收听时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shazam 等延伸功能可以擷取分頁播放的音訊，但僅限你使用它們收聽時。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Shown by macOS when a website first asks to use the camera.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Websites you visit can ask to use your camera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセスしたWebサイトが、カメラの使用を求めることがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你访问的网站可以请求使用你的摄像头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你造訪的網站可以要求使用你的相機。"
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Shown by macOS when Zigzag first asks to read the person's own card in Contacts, to fill forms.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Zigzag fills your name, email, phone and address into forms from your own card in Contacts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzagは「連絡先」の自分のカードから、名前、メール、電話番号、住所をフォームに入力します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 会用你在“通讯录”中自己的名片，在表单中填写你的姓名、电子邮件、电话和地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 會使用「聯絡人」中你的名片，在表單填入姓名、電子郵件、電話號碼和地址。"
          }
        }
      }
    },
    "NSDownloadsFolderUsageDescription" : {
      "comment" : "Shown by macOS when Zigzag first saves into the Downloads folder.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Zigzag saves the files you download here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzagは、ダウンロードしたファイルをここに保存します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 会把你下载的文件存储在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 會將你下載的檔案儲存在這裡。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Shown by macOS when a website first reaches a device on the local network.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Websites you visit can ask to connect to devices on your local network."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセスしたWebサイトが、ローカルネットワーク上のデバイスへの接続を求めることがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你访问的网站可以请求连接到你本地网络上的设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你造訪的網站可以要求連線到區域網路上的裝置。"
          }
        }
      }
    },
    "NSLocationUsageDescription" : {
      "comment" : "Shown by macOS when a website first asks for the location.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Websites you visit can ask for your location."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセスしたWebサイトが、位置情報を求めることがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你访问的网站可以请求获取你的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你造訪的網站可以要求取得你的所在位置。"
          }
        }
      }
    },
