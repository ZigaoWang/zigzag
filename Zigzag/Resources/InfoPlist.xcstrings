            "value" : "アクセスしたWebサイトが、マイクの使用を求めることがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你访问的网站可以请求使用你的麦克风。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
