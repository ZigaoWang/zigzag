{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAudioCaptureUsageDescription" : {
      "comment" : "Shown by macOS when an extension first listens to a tab's sound. Shazam is a product name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erweiterungen wie Shazam können hören, was ein Tab abspielt, aber nur, solange sie zuhören."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Extensions you use, like Shazam, can hear what a tab plays, only while they listen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las extensiones que usas, como Shazam, pueden oír lo que reproduce una pestaña, solo mientras escuchan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les extensions que vous utilisez, comme Shazam, peuvent entendre ce que lit un onglet, uniquement pendant leur écoute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le estensioni che usi, come Shazam, possono ascoltare l’audio di un pannello, solo mentre sono in ascolto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shazamなど、使用している機能拡張は、聞き取っているあいだだけ、タブで再生中の音を聞くことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shazam 같은 확장 프로그램은 듣고 있는 동안에만 탭에서 재생되는 소리를 들을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extensies die je gebruikt, zoals Shazam, kunnen horen wat een tabblad afspeelt, alleen terwijl ze luisteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozszerzenia, których używasz, na przykład Shazam, mogą słyszeć, co odtwarza karta, tylko podczas słuchania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As extensões que você usa (como o Shazam) podem ouvir o som reproduzido nas abas, mas somente enquanto estiverem ouvindo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расширения, которыми вы пользуетесь, например Shazam, могут слышать, что воспроизводит вкладка, только пока они слушают."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullandığınız Shazam gibi genişletmeler, bir sekmenin çaldığı sesi yalnızca dinlerken duyabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你使用的扩展（比如 Shazam）可以听到标签页播放的声音，但只在它们收听时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shazam 等延伸功能可以擷取分頁播放的音訊，但僅限你使用它們收聽時。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Shown by macOS when a website first asks to use the camera.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites, die du besuchst, können um Zugriff auf deine Kamera bitten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Websites you visit can ask to use your camera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sitios web que visitas pueden pedir permiso para usar tu cámara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sites web que vous consultez peuvent demander à utiliser votre caméra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I siti web che visiti possono chiedere di usare la fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセスしたWebサイトが、カメラの使用を求めることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방문하는 웹 사이트에서 카메라 사용을 요청할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites die je bezoekt, kunnen vragen om je camera te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odwiedzane witryny mogą prosić o użycie kamery."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os sites que você visita podem pedir para usar a sua câmera."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сайты, которые вы посещаете, могут запросить доступ к камере."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziyaret ettiğiniz web siteleri kameranızı kullanmak için izin isteyebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你访问的网站可以请求使用你的摄像头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你造訪的網站可以要求使用你的相機。"
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Shown by macOS when Zigzag first asks to read the person's own card in Contacts, to fill forms.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag füllt deinen Namen, deine E-Mail-Adresse, Telefonnummer und Adresse aus deiner eigenen Karte in den Kontakten in Formulare ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Zigzag fills your name, email, phone and address into forms from your own card in Contacts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag rellena tu nombre, correo electrónico, teléfono y dirección en los formularios con tu propia tarjeta de Contactos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag remplit les formulaires avec vos nom, e-mail, téléphone et adresse à partir de votre propre fiche dans Contacts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag compila nei moduli il tuo nome, l’email, il telefono e l’indirizzo dalla tua scheda in Contatti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzagは「連絡先」の自分のカードから、名前、メール、電話番号、住所をフォームに入力します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag는 연락처의 나의 카드에 있는 이름, 이메일, 전화번호 및 주소를 양식에 채웁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag vult je naam, e-mail, telefoon en adres in formulieren in vanuit je eigen kaart in Contacten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag wypełnia formularze imieniem i nazwiskiem, adresem e-mail, numerem telefonu i adresem z twojej karty w Kontaktach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zigzag usa o seu próprio cartão em Contatos para preencher nome, e-mail, telefone e endereço em formulários."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag подставляет ваше имя, почту, телефон и адрес в формы из вашей карточки в «Контактах»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag, adınızı, e-postanızı, telefonunuzu ve adresinizi Kişiler’deki kendi kartınızdan formlara doldurur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 会用你在“通讯录”中自己的名片，在表单中填写你的姓名、电子邮件、电话和地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 會使用「聯絡人」中你的名片，在表單填入姓名、電子郵件、電話號碼和地址。"
          }
        }
      }
    },
    "NSDownloadsFolderUsageDescription" : {
      "comment" : "Shown by macOS when Zigzag first saves into the Downloads folder.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag sichert hier die Dateien, die du lädst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Zigzag saves the files you download here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag guarda aquí los archivos que descargas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag enregistre ici les fichiers que vous téléchargez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag salva qui i file che scarichi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzagは、ダウンロードしたファイルをここに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag는 다운로드한 파일을 여기에 저장합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag bewaart hier de bestanden die je downloadt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag zachowuje tutaj pobrane pliki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zigzag salva aqui os arquivos que você baixa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag сохраняет здесь файлы, которые вы загружаете."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag indirdiğiniz dosyaları buraya kaydeder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 会把你下载的文件存储在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zigzag 會將你下載的檔案儲存在這裡。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Shown by macOS when a website first reaches a device on the local network.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites, die du besuchst, können um Verbindung mit Geräten in deinem lokalen Netzwerk bitten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Websites you visit can ask to connect to devices on your local network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sitios web que visitas pueden pedir conectarse a dispositivos de tu red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sites web que vous consultez peuvent demander à se connecter aux appareils de votre réseau local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I siti web che visiti possono chiedere di connettersi ai dispositivi della tua rete locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセスしたWebサイトが、ローカルネットワーク上のデバイスへの接続を求めることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방문하는 웹 사이트에서 로컬 네트워크의 기기에 연결하도록 요청할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites die je bezoekt, kunnen vragen om verbinding te maken met apparaten op je lokale netwerk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odwiedzane witryny mogą prosić o połączenie z urządzeniami w sieci lokalnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os sites que você visita podem pedir para se conectar a dispositivos na sua rede local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сайты, которые вы посещаете, могут запросить подключение к устройствам в вашей локальной сети."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziyaret ettiğiniz web siteleri yerel ağınızdaki aygıtlara bağlanmak için izin isteyebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你访问的网站可以请求连接到你本地网络上的设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你造訪的網站可以要求連線到區域網路上的裝置。"
          }
        }
      }
    },
