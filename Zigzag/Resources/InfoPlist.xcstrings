      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Websites you visit can ask for your location."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你访问的网站可以请求获取你的位置。"
